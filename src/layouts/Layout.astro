---
interface Props {
	title: string;
}

const { title } = Astro.props;
const navItems = [
	{ href: '/', label: 'HOME' },
	{ href: '/filmography', label: 'EDITING · WORKS' },
	{ href: '/ip-development', label: 'IP DEVELOPMENT' },
	{ href: '/about', label: 'ABOUT' },
	{ href: '/contact', label: 'CONTACT' },
	{ href: '/login', label: 'LOGIN', id: 'nav-login' },
	{ href: '/admin', label: 'ADMIN', id: 'nav-admin' },
	{ href: '#', label: 'LOGOUT', id: 'nav-logout' },
];
const currentPath = Astro.url.pathname;
---

<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<style is:global>
			@font-face {
				font-family: 'NanumSquareRound';
				src: url('/fonts/NanumSquareRound-Regular.otf') format('opentype');
				font-weight: 400;
				font-display: swap;
			}
			@font-face {
				font-family: 'NanumSquareRound';
				src: url('/fonts/NanumSquareRound-Bold.otf') format('opentype');
				font-weight: 700;
				font-display: swap;
			}
			@font-face {
				font-family: 'NanumSquareRound';
				src: url('/fonts/NanumSquareRound-ExtraBold.otf') format('opentype');
				font-weight: 800;
				font-display: swap;
			}
			:root {
				color-scheme: dark;
				font-family: 'NanumSquareRound', -apple-system, BlinkMacSystemFont, system-ui, Roboto,
					'Helvetica Neue', 'Segoe UI', 'Apple SD Gothic Neo', sans-serif;

				/* 브랜드 가이드 공식 팔레트 — Primary Blue #134DEC + 뉴트럴 스케일, 다크 배경 기준 */
				--bg: #1b1c1d;
				--surface: #2c2d30;
				--surface-strong: #45464a;
				--fg: #f4f5f5;
				--muted: #a0a1a7;
				--heading: #fafafa;
				--accent: #134dec;
				--accent-dim: rgba(19, 77, 236, 0.22);
				--border: #45464a;
				--shadow: 0 1px 2px rgba(19, 77, 236, 0.1), 0 10px 24px rgba(19, 77, 236, 0.12);
				--shadow-hover: 0 2px 4px rgba(19, 77, 236, 0.16), 0 16px 32px rgba(19, 77, 236, 0.22);
			}
			body {
				margin: 0;
				line-height: 1.6;
				background: var(--bg);
				color: var(--fg);
			}
			h1,
			h2 {
				color: var(--heading);
			}
			a {
				color: inherit;
				text-decoration: none;
			}
			:focus-visible {
				outline: 2px solid var(--accent);
				outline-offset: 2px;
			}
			.page {
				max-width: 1100px;
				margin-inline: auto;
				padding: 0 2rem 4rem;
			}
			.site-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				max-width: 1100px;
				margin-inline: auto;
				padding: 2rem;
				gap: 2rem;
			}
			.site-header .logo {
				flex-shrink: 0;
				display: inline-flex;
				align-items: center;
				border-bottom: 2px solid transparent;
				transition: border-color 0.15s ease;
			}
			.site-header .logo img {
				display: block;
				height: 28px;
				width: auto;
			}
			.site-header .logo:hover {
				border-color: var(--accent);
			}
			.site-nav {
				display: flex;
				flex-wrap: wrap;
				gap: 1.5rem;
			}
			.site-nav a {
				font-size: 0.8rem;
				font-weight: 600;
				letter-spacing: 0.05em;
				color: var(--muted);
				transition: color 0.15s ease;
			}
			.site-nav a:hover {
				color: var(--fg);
			}
			.site-nav a[aria-current='page'] {
				color: var(--heading);
			}
			.back-link {
				display: inline-block;
				margin-bottom: 1.5rem;
				color: var(--muted);
				transition: color 0.15s ease;
			}
			.back-link:hover {
				color: var(--fg);
			}
			.site-footer {
				max-width: 1100px;
				margin-inline: auto;
				padding: 2rem;
				border-top: 1px solid var(--border);
				color: var(--muted);
				font-size: 0.8rem;
			}
		</style>
	</head>
	<body>
		<header class="site-header">
			<a class="logo" href="/"><img src="/images/brand/logo-horizontal-white.png" alt="Hooking Point" /></a>
			<nav class="site-nav">
				{navItems.map((item) => (
					<a
						href={item.href}
						id={item.id}
						aria-current={currentPath === item.href ? 'page' : undefined}
						style={item.id ? 'display:none' : undefined}
					>
						{item.label}
					</a>
				))}
			</nav>
		</header>
		<slot />
		<footer class="site-footer">© Hooking Point. All rights reserved.</footer>
		<script>
			import { supabase } from '../lib/supabase';

			const loginLink = document.getElementById('nav-login');
			const adminLink = document.getElementById('nav-admin');
			const logoutLink = document.getElementById('nav-logout');

			async function updateNav() {
				const { data: { session } } = await supabase.auth.getSession();
				if (session) {
					loginLink?.style.setProperty('display', 'none');
					logoutLink?.style.removeProperty('display');

					const { data: profile } = await supabase
						.from('profiles')
						.select('role, ai_tools_access')
						.eq('id', session.user.id)
						.single();

					if (profile?.role === 'admin') {
						adminLink?.style.removeProperty('display');
					} else {
						adminLink?.style.setProperty('display', 'none');
					}
				} else {
					loginLink?.style.removeProperty('display');
					logoutLink?.style.setProperty('display', 'none');
					adminLink?.style.setProperty('display', 'none');
				}
			}

			updateNav();

			logoutLink?.addEventListener('click', async (e) => {
				e.preventDefault();
				await supabase.auth.signOut();
				window.location.href = '/';
			});
		</script>
	</body>
</html>
