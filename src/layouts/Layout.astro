---
interface Props {
	title: string;
	description?: string;
}

const { title, description = '영화·드라마 편집 및 IP 기획·개발 스튜디오 후킹포인트입니다.' } = Astro.props;
const siteUrl = 'https://hooking-point.pages.dev';
const ogImageUrl = `${siteUrl}/og-image.png`;
const icons = {
	home: '<path d="M4 11.5 12 4l8 7.5M6 10v9h5v-5h2v5h5v-9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>',
	video: '<circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M10 9l5 3-5 3z" fill="currentColor" stroke="none"/>',
	bulb: '<path d="M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.5.4.8 1 .9 1.6h5.2c.1-.6.4-1.2.9-1.6A6 6 0 0 0 12 3z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>',
	info: '<circle cx="12" cy="12" r="9" fill="none" stroke="currentColor" stroke-width="1.8"/><line x1="12" y1="11" x2="12" y2="16" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/><circle cx="12" cy="7.5" r="1" fill="currentColor"/>',
	mail: '<rect x="3.5" y="5.5" width="17" height="13" rx="2" fill="none" stroke="currentColor" stroke-width="1.8"/><path d="M4 7l8 6 8-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>',
	login: '<path d="M11 4H6a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M14 8l4 4-4 4M18 12H9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>',
	logout: '<path d="M13 4h5a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/><path d="M10 8l-4 4 4 4M6 12h9" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>',
	shield: '<path d="M12 3l7 3v6c0 4.5-3 7.7-7 9-4-1.3-7-4.5-7-9V6l7-3z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>',
	wrench: '<path d="M21 7.5a4.5 4.5 0 0 1-6.1 4.2L7 19.6 4.4 17l7.9-7.9A4.5 4.5 0 0 1 16.5 3c.6 0 1.2.1 1.7.3l-3.4 3.4 1.5 1.5 3.4-3.4c.2.5.3 1.1.3 1.7Z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/>',
};
const navItems = [
	{ href: '/', label: 'HOME', icon: 'home' },
	{ href: '/filmography', label: 'EDITING : 작품별 편집 로그', icon: 'video' },
	{ href: '/ip-development', label: 'IP정보', icon: 'bulb' },
	{ href: '/ip-development-tools', label: 'IP DEVELOPMENT', icon: 'wrench' },
	{ href: '/about', label: 'ABOUT', icon: 'info' },
	{ href: '/contact', label: 'CONTACT', icon: 'mail' },
	{ href: '/login', label: 'LOGIN', id: 'nav-login', icon: 'login' },
	{ href: '/admin', label: 'ADMIN', id: 'nav-admin', icon: 'shield' },
	{ href: '#', label: 'LOGOUT', id: 'nav-logout', icon: 'logout' },
];
const currentPath = Astro.url.pathname;
---

<html lang="ko">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=1180" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Hooking Point" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageUrl} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:url" content={new URL(Astro.url.pathname, siteUrl).toString()} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl} />
		<style is:global>
			@font-face {
				font-family: 'NanumSquareRound';
				src: url('/fonts/NanumSquareRound-Regular.otf') format('opentype');
				font-weight: 400;
				font-display: swap;
			}
			@font-face {
				font-family: 'NanumSquareRound';
				src: url('/fonts/NanumSquareRound-Bold.otf') format('opentype');
				font-weight: 700;
				font-display: swap;
			}
			@font-face {
				font-family: 'NanumSquareRound';
				src: url('/fonts/NanumSquareRound-ExtraBold.otf') format('opentype');
				font-weight: 800;
				font-display: swap;
			}
			:root {
				color-scheme: dark;
				font-family: 'NanumSquareRound', -apple-system, BlinkMacSystemFont, system-ui, Roboto,
					'Helvetica Neue', 'Segoe UI', 'Apple SD Gothic Neo', sans-serif;

				/* 브랜드 가이드 공식 팔레트 — Primary Blue #134DEC + 뉴트럴 스케일, 다크 배경 기준 */
				--bg: #1b1c1d;
				--surface: #2c2d30;
				--surface-strong: #45464a;
				--fg: #f4f5f5;
				--muted: #a0a1a7;
				--heading: #fafafa;
				--accent: #134dec;
				--accent-dim: rgba(19, 77, 236, 0.22);
				--border: #45464a;
				--shadow: 0 1px 2px rgba(19, 77, 236, 0.1), 0 10px 24px rgba(19, 77, 236, 0.12);
				--shadow-hover: 0 2px 4px rgba(19, 77, 236, 0.16), 0 16px 32px rgba(19, 77, 236, 0.22);
			}
			body {
				margin: 0;
				line-height: 1.6;
				background: var(--bg);
				color: var(--fg);
				padding-left: 64px;
				cursor: url('/images/brand/cursor-symbol.svg') 16 15, auto;
			}
			.icon-rail {
				position: fixed;
				top: 0;
				left: 0;
				bottom: 0;
				width: 64px;
				background: var(--surface);
				border-right: 1px solid var(--border);
				display: flex;
				flex-direction: column;
				align-items: center;
				padding: 1.25rem 0;
				gap: 0.375rem;
				z-index: 20;
			}
			.icon-rail .rail-logo {
				width: 30px;
				height: 30px;
				margin-bottom: 0.75rem;
				display: flex;
				flex-shrink: 0;
			}
			.icon-rail .rail-logo img {
				width: 100%;
				height: auto;
			}
			.icon-rail a {
				position: relative;
				flex-shrink: 0;
				width: 40px;
				height: 40px;
				border-radius: 10px;
				display: flex;
				align-items: center;
				justify-content: center;
				color: var(--muted);
				transition: color 0.15s ease, background-color 0.15s ease;
			}
			.icon-rail a:hover {
				color: var(--fg);
				background: var(--surface-strong);
			}
			.icon-rail a[aria-current='page'] {
				color: var(--heading);
				background: var(--accent);
			}
			.icon-rail .rail-spacer {
				flex: 1;
			}
			.icon-rail .rail-tooltip {
				position: absolute;
				left: calc(100% + 10px);
				top: 50%;
				transform: translateY(-50%);
				background: var(--surface-strong);
				color: var(--fg);
				font-size: 0.75rem;
				font-weight: 600;
				letter-spacing: 0.04em;
				padding: 0.4rem 0.7rem;
				border-radius: 6px;
				white-space: nowrap;
				opacity: 0;
				pointer-events: none;
				transition: opacity 0.15s ease;
			}
			.icon-rail a:hover .rail-tooltip {
				opacity: 1;
			}
			h1,
			h2 {
				color: var(--heading);
			}
			a {
				color: inherit;
				text-decoration: none;
			}
			:focus-visible {
				outline: 2px solid var(--accent);
				outline-offset: 2px;
			}
			.page {
				max-width: 1100px;
				margin-inline: auto;
				padding: 0 2rem 4rem;
			}
			.site-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				max-width: 1100px;
				margin-inline: auto;
				padding: 2rem;
				gap: 2rem;
			}
			.site-header .logo {
				flex-shrink: 0;
				display: inline-flex;
				align-items: center;
				border-bottom: 2px solid transparent;
				transition: border-color 0.15s ease;
			}
			.site-header .logo img {
				display: block;
				height: 28px;
				width: auto;
			}
			.site-header .logo:hover {
				border-color: var(--accent);
			}
			.header-right {
				display: flex;
				align-items: center;
				flex-wrap: wrap;
				gap: 1.5rem;
			}
			.site-nav {
				display: flex;
				flex-wrap: wrap;
				gap: 1.5rem;
			}
			.notif-wrap {
				position: relative;
				flex-shrink: 0;
			}
			.notif-bell {
				position: relative;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				background: none;
				border: none;
				color: var(--muted);
				cursor: pointer;
				padding: 0.2rem;
				transition: color 0.15s ease;
			}
			.notif-bell:hover {
				color: var(--fg);
			}
			.notif-badge {
				position: absolute;
				top: -4px;
				right: -6px;
				min-width: 15px;
				height: 15px;
				padding: 0 3px;
				border-radius: 999px;
				background: var(--accent);
				color: #fff;
				font-size: 0.62rem;
				font-weight: 700;
				line-height: 15px;
				text-align: center;
			}
			.notif-panel {
				position: absolute;
				top: calc(100% + 12px);
				right: 0;
				width: 320px;
				max-height: 400px;
				overflow-y: auto;
				background: var(--surface);
				border: 1px solid var(--border);
				border-radius: 10px;
				box-shadow: var(--shadow-hover);
				z-index: 30;
			}
			.notif-panel-head {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding: 0.8rem 1rem;
				border-bottom: 1px solid var(--border);
				font-size: 0.85rem;
				font-weight: 700;
				color: var(--heading);
			}
			.notif-panel-head button {
				font: inherit;
				font-size: 0.75rem;
				font-weight: 600;
				background: none;
				border: none;
				color: var(--accent);
				cursor: pointer;
			}
			.notif-item {
				display: block;
				padding: 0.7rem 1rem;
				border-bottom: 1px solid var(--border);
				font-size: 0.82rem;
				line-height: 1.5;
				color: var(--fg);
			}
			.notif-item:last-child {
				border-bottom: none;
			}
			.notif-item.unread {
				background: var(--accent-dim);
			}
			.notif-item .notif-time {
				display: block;
				margin-top: 0.2rem;
				font-size: 0.72rem;
				color: var(--muted);
			}
			.notif-empty {
				padding: 1.2rem 1rem;
				font-size: 0.82rem;
				color: var(--muted);
				text-align: center;
			}
			.social-links {
				display: flex;
				align-items: center;
				gap: 0.75rem;
				flex-shrink: 0;
			}
			.social-links a {
				display: inline-flex;
				color: var(--muted);
				transition: color 0.15s ease;
			}
			.social-links a:hover {
				color: var(--fg);
			}
			.site-nav a {
				font-size: 0.8rem;
				font-weight: 600;
				letter-spacing: 0.05em;
				color: var(--muted);
				transition: color 0.15s ease;
			}
			.site-nav a:hover {
				color: var(--fg);
			}
			.site-nav a[aria-current='page'] {
				color: var(--heading);
			}
			.back-link {
				display: inline-block;
				margin-bottom: 1.5rem;
				color: var(--muted);
				transition: color 0.15s ease;
			}
			.back-link:hover {
				color: var(--fg);
			}
			.site-footer {
				max-width: 1100px;
				margin-inline: auto;
				padding: 2rem;
				border-top: 1px solid var(--border);
				color: var(--muted);
				font-size: 0.8rem;
			}
		</style>
	</head>
	<body>
		<nav class="icon-rail" aria-label="빠른 메뉴">
			<a class="rail-logo" href="/" aria-label="Hooking Point 홈"><img src="/images/brand/symbol-white.svg" alt="" /></a>
			{navItems.map((item) => (
				<a
					href={item.href}
					id={item.id ? `rail-${item.id}` : undefined}
					aria-current={currentPath === item.href ? 'page' : undefined}
					aria-label={item.label}
					style={item.id ? 'display:none' : undefined}
					set:html={`<svg viewBox="0 0 24 24" width="20" height="20">${icons[item.icon]}</svg><span class="rail-tooltip">${item.label}</span>`}
				/>
			))}
		</nav>
		<header class="site-header">
			<a class="logo" href="/"><img src="/images/brand/logo-horizontal-white.png" alt="Hooking Point" /></a>
			<div class="header-right">
				<nav class="site-nav">
					{navItems.map((item) => (
						<a
							href={item.href}
							id={item.id}
							aria-current={currentPath === item.href ? 'page' : undefined}
							style={item.id ? 'display:none' : undefined}
						>
							{item.label}
						</a>
					))}
				</nav>
				<div class="notif-wrap" id="notif-wrap" style="display:none;">
					<button type="button" class="notif-bell" id="notif-bell" aria-label="알림">
						<svg viewBox="0 0 24 24" width="19" height="19"><path d="M6 10a6 6 0 0 1 12 0c0 4 1.5 5.5 2 6H4c.5-.5 2-2 2-6Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M10 19a2 2 0 0 0 4 0" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg>
						<span class="notif-badge" id="notif-badge" hidden>0</span>
					</button>
					<div class="notif-panel" id="notif-panel" hidden>
						<div class="notif-panel-head">
							<span>알림</span>
							<button type="button" id="notif-mark-all">모두 읽음</button>
						</div>
						<div id="notif-list"></div>
					</div>
				</div>
				<div class="social-links">
					<a href="https://www.instagram.com/hooking.point" aria-label="Instagram" target="_blank" rel="noopener">
						<svg viewBox="0 0 24 24" width="18" height="18"><rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="1.8"/><circle cx="17.2" cy="6.8" r="1" fill="currentColor"/></svg>
					</a>
					<a href="#" aria-label="카카오톡" target="_blank" rel="noopener">
						<svg viewBox="0 0 24 24" width="18" height="18"><path d="M12 4C6.9 4 3 7.2 3 11.1c0 2.5 1.6 4.7 4 6L6 21l4.2-2.3c.6.1 1.2.1 1.8.1 5.1 0 9-3.2 9-7.1S17.1 4 12 4Z" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg>
					</a>
				</div>
			</div>
		</header>
		<slot />
		<footer class="site-footer">© Hooking Point. All rights reserved.</footer>
		<script>
			import { supabase } from '../lib/supabase';

			const loginLinks = document.querySelectorAll('#nav-login, #rail-nav-login');
			const adminLinks = document.querySelectorAll('#nav-admin, #rail-nav-admin');
			const logoutLinks = document.querySelectorAll('#nav-logout, #rail-nav-logout');

			const notifWrap = document.getElementById('notif-wrap');
			const notifBell = document.getElementById('notif-bell');
			const notifPanel = document.getElementById('notif-panel');
			const notifBadge = document.getElementById('notif-badge');
			const notifList = document.getElementById('notif-list');
			const notifMarkAll = document.getElementById('notif-mark-all');

			async function updateNav() {
				const { data: { session } } = await supabase.auth.getSession();
				if (session) {
					loginLinks.forEach((el) => el.style.setProperty('display', 'none'));
					logoutLinks.forEach((el) => el.style.removeProperty('display'));

					const { data: profile } = await supabase
						.from('profiles')
						.select('role, ai_tools_access')
						.eq('id', session.user.id)
						.single();

					if (profile?.role === 'admin') {
						adminLinks.forEach((el) => el.style.removeProperty('display'));
					} else {
						adminLinks.forEach((el) => el.style.setProperty('display', 'none'));
					}

					if (profile?.role === 'admin' || profile?.ai_tools_access === true) {
						notifWrap?.style.removeProperty('display');
						loadNotifications(session.user.id);
					} else {
						notifWrap?.style.setProperty('display', 'none');
					}
				} else {
					loginLinks.forEach((el) => el.style.removeProperty('display'));
					logoutLinks.forEach((el) => el.style.setProperty('display', 'none'));
					adminLinks.forEach((el) => el.style.setProperty('display', 'none'));
					notifWrap?.style.setProperty('display', 'none');
				}
			}

			function escapeHtml(s) {
				return s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));
			}

			async function loadNotifications(myId) {
				if (!notifList) return;
				const { data, error } = await supabase
					.from('ip_project_notifications')
					.select('*')
					.eq('recipient_id', myId)
					.order('created_at', { ascending: false })
					.limit(20);

				if (error || !data) return;

				const unreadCount = data.filter((n) => !n.is_read).length;
				if (notifBadge) {
					if (unreadCount > 0) {
						notifBadge.textContent = unreadCount > 9 ? '9+' : String(unreadCount);
						notifBadge.removeAttribute('hidden');
					} else {
						notifBadge.setAttribute('hidden', '');
					}
				}

				if (data.length === 0) {
					notifList.innerHTML = `<p class="notif-empty">아직 알림이 없습니다.</p>`;
					return;
				}

				const projectIds = [...new Set(data.map((n) => n.project_id).filter(Boolean))];
				const [{ data: projects }, { data: members }] = await Promise.all([
					projectIds.length
						? supabase.from('ip_projects').select('id, title').in('id', projectIds)
						: Promise.resolve({ data: [] }),
					supabase.rpc('list_team_members'),
				]);
				const projectTitle = (id) => projects?.find((p) => p.id === id)?.title || id;
				const actorName = (id) => {
					const m = members?.find((m) => m.id === id);
					return m ? (m.name || m.username || '팀원') : '팀원';
				};

				const NOTIF_TEXT = {
					mention: (actor, project) => `${actor}님이 <strong>${project}</strong> 댓글에서 회원님을 멘션했습니다.`,
					assignment: (actor, project) => `${actor}님이 <strong>${project}</strong>의 할 일을 회원님에게 배정했습니다.`,
					status_change: (actor, project) => `${actor}님이 <strong>${project}</strong>의 단계를 변경했습니다.`,
				};

				notifList.innerHTML = data.map((n) => {
					const build = NOTIF_TEXT[n.type] || NOTIF_TEXT.assignment;
					const text = build(escapeHtml(actorName(n.actor_id)), escapeHtml(projectTitle(n.project_id)));
					return `
						<a class="notif-item ${n.is_read ? '' : 'unread'}" href="/ip-development-tools/${n.project_id}" data-id="${n.id}">
							${text}
							<span class="notif-time">${new Date(n.created_at).toLocaleString('ko-KR')}</span>
						</a>
					`;
				}).join('');

				notifList.querySelectorAll('.notif-item').forEach((el) => {
					el.addEventListener('click', async () => {
						await supabase.from('ip_project_notifications').update({ is_read: true }).eq('id', el.dataset.id);
					});
				});
			}

			notifBell?.addEventListener('click', () => {
				const isHidden = notifPanel?.hasAttribute('hidden');
				if (isHidden) notifPanel?.removeAttribute('hidden');
				else notifPanel?.setAttribute('hidden', '');
			});

			document.addEventListener('click', (e) => {
				if (notifWrap && !notifWrap.contains(e.target)) {
					notifPanel?.setAttribute('hidden', '');
				}
			});

			notifMarkAll?.addEventListener('click', async () => {
				const { data: { session } } = await supabase.auth.getSession();
				if (!session) return;
				await supabase.from('ip_project_notifications').update({ is_read: true }).eq('recipient_id', session.user.id).eq('is_read', false);
				loadNotifications(session.user.id);
			});

			updateNav();

			logoutLinks.forEach((el) => {
				el.addEventListener('click', async (e) => {
					e.preventDefault();
					await supabase.auth.signOut();
					window.location.href = '/';
				});
			});
		</script>
	</body>
</html>
