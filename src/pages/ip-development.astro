---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('ipProjects')).sort(
	(a, b) => (a.data.sortOrder ?? 0) - (b.data.sortOrder ?? 0)
);

const STAGES = ['기획', '트리트먼트', '대본', '개발', '피칭'];
---

<Layout title="IP정보 — Hooking Point">
	<div class="hero-band">
		<span class="blob blob-1" aria-hidden="true"></span>
		<span class="blob blob-2" aria-hidden="true"></span>
		<div class="hero-band-inner">
			<h1>IP정보</h1>
		</div>
	</div>

	<div class="page">
		<a class="back-link" href="/">← 홈으로</a>

		<p class="intro">현재 개발 중인 오리지널 IP입니다. 시놉시스·기획의도·주요 이미지 등 상세정보는 관리자로부터 열람 권한을 부여받은 회원만 확인할 수 있습니다. 궁금하신 작품이 있다면 <a href="mailto:hooking.point@gmail.com">hooking.point@gmail.com</a>으로 열람 요청 주세요.</p>

		<div class="filters" role="tablist">
			<button type="button" class="filter" data-filter="전체" aria-pressed="true">전체</button>
			{STAGES.map((s) => (
				<button type="button" class="filter" data-filter={s} aria-pressed="false">{s}</button>
			))}
		</div>

		<ul class="ip-grid">
			{projects.map((p) => (
				<li class="ip-card-item" data-stage={p.data.stage}>
					<a class="ip-card" href={`/ip-development/${p.id}`}>
						<span class="ip-genre">[{p.data.genre}]</span>
						<span class="ip-title">{p.data.title}</span>
						<span class="ip-meta">{p.data.stage}{p.data.year ? ` · ${p.data.year}` : ''}</span>
					</a>
				</li>
			))}
		</ul>
	</div>
</Layout>

<script>
	const filters = document.querySelectorAll<HTMLButtonElement>('.filter');
	const cards = document.querySelectorAll<HTMLLIElement>('.ip-card-item');

	filters.forEach((btn) => {
		btn.addEventListener('click', () => {
			filters.forEach((b) => b.setAttribute('aria-pressed', 'false'));
			btn.setAttribute('aria-pressed', 'true');
			const target = btn.dataset.filter;
			cards.forEach((card) => {
				const show = target === '전체' || card.dataset.stage === target;
				card.style.display = show ? '' : 'none';
			});
		});
	});
</script>

<style>
	.hero-band {
		position: relative;
		overflow: hidden;
		background: linear-gradient(135deg, #0f2fa8, var(--accent) 60%, #2e64f2);
		padding: 1.75rem 2rem;
		margin-bottom: 2.5rem;
	}
	.hero-band-inner {
		position: relative;
		z-index: 1;
		max-width: 1100px;
		margin-inline: auto;
	}
	.hero-band h1 {
		margin: 0;
		font-size: 1.7rem;
		color: #fff;
	}
	.blob {
		position: absolute;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.08);
		filter: blur(2px);
	}
	.blob-1 {
		width: 220px;
		height: 220px;
		top: -160px;
		right: 8%;
	}
	.blob-2 {
		width: 160px;
		height: 160px;
		bottom: -130px;
		right: 24%;
		background: rgba(255, 255, 255, 0.06);
	}

	.back-link {
		display: inline-block;
		margin-bottom: 1.5rem;
		color: var(--muted);
		transition: color 0.15s ease;
	}
	.back-link:hover {
		color: var(--fg);
	}

	.intro {
		color: var(--muted);
		max-width: 40rem;
		margin: 0 0 2.5rem;
	}

	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		margin-bottom: 2.5rem;
	}
	.filter {
		font: inherit;
		font-size: 0.9rem;
		font-weight: 600;
		background: none;
		border: none;
		color: var(--muted);
		border-radius: 999px;
		padding: 0.5rem 1.1rem;
		cursor: pointer;
		transition: color 0.15s ease, background-color 0.15s ease;
	}
	.filter:hover {
		color: var(--heading);
	}
	.filter[aria-pressed='true'] {
		background: var(--surface-strong);
		color: var(--heading);
	}

	.ip-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 2rem 1.5rem;
	}
	.ip-card {
		display: block;
		color: inherit;
		transition: transform 0.15s ease;
	}
	.ip-card:hover {
		transform: translateY(-2px);
	}
	.ip-genre {
		display: block;
		font-size: 0.8rem;
		font-weight: 700;
		color: var(--accent);
		margin-bottom: 0.3rem;
	}
	.ip-title {
		display: block;
		font-size: 1rem;
		font-weight: 700;
		color: var(--heading);
		margin-bottom: 0.2rem;
	}
	.ip-meta {
		display: block;
		font-size: 0.85rem;
		color: var(--muted);
	}
</style>
