<style>
	.hero-bg {
		min-height: 100vh;
		display: flex;
		align-items: center;
		justify-content: center;
		background: radial-gradient(900px circle at 50% 50%, rgba(19, 77, 236, 0.22), transparent 70%);
	}
	.hero {
		padding: 0;
		display: flex;
		flex-direction: column;
		align-items: center;
	}
	.hero-symbol {
		overflow: visible;
	}
	.hero-word {
		margin: 0.15rem 0 0;
		width: 220px;
		height: auto;
	}

	.sym-ball {
		transform-origin: 39.59px 42.55px;
	}
	.sym-rings {
		transform-origin: 40px 42px;
	}
	.ripple {
		transform-origin: 40px 42px;
		opacity: 0;
	}

	@media (prefers-reduced-motion: no-preference) {
		/* 1) 찌와 후크가 함께 떨어진다 */
		.sym-ball {
			animation: ball-drop 0.7s cubic-bezier(0.32, 1.3, 0.6, 1) both;
		}
		.sym-hook {
			opacity: 0;
			animation: ball-drop 0.7s cubic-bezier(0.32, 1.3, 0.6, 1) both;
		}
		/* 2) 그 다음 물결이 퍼진다 */
		.ripple-1 {
			animation: ripple-out 1.1s ease-out 0.65s both;
		}
		.ripple-2 {
			animation: ripple-out 1.1s ease-out 0.8s both;
		}
		.sym-rings {
			opacity: 0;
			animation: rings-in 0.7s ease-out 0.7s both;
		}
		/* 3) 물결이 생기고 0.3초 후, 심볼 전체 프레임이 서서히 또렷해진다 */
		.sym-letters {
			opacity: 0;
			animation: letters-in 1.2s ease-in-out 0.95s both;
		}
		.hero-word {
			opacity: 0;
			animation: word-in 0.8s ease-out 2.15s both;
		}
	}

	@keyframes ball-drop {
		0% {
			transform: translateY(-140px);
			opacity: 0;
		}
		55% {
			opacity: 1;
		}
		100% {
			transform: translateY(0);
			opacity: 1;
		}
	}
	@keyframes rings-in {
		from {
			opacity: 0;
			transform: scale(0.35);
		}
		to {
			opacity: 1;
			transform: scale(1);
		}
	}
	@keyframes letters-in {
		from {
			opacity: 0;
			filter: blur(7px);
		}
		to {
			opacity: 1;
			filter: blur(0);
		}
	}
	@keyframes word-in {
		from {
			opacity: 0;
			transform: translateY(6px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}
	@keyframes ripple-out {
		0% {
			transform: scale(0.3);
			opacity: 0.9;
		}
		100% {
			transform: scale(4.5);
			opacity: 0;
		}
	}
</style>
