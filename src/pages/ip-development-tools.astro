---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('ipProjects')).sort(
	(a, b) => (a.data.sortOrder ?? 0) - (b.data.sortOrder ?? 0)
);

const STAGES = ['기획', '트리트먼트', '대본', '개발', '피칭'];

const projectsData = projects.map((p) => ({
	id: p.id,
	title: p.data.title,
	genre: p.data.genre,
	stage: p.data.stage,
	year: p.data.year ?? null,
	targetDate: p.data.targetDate ?? null,
	sortOrder: p.data.sortOrder ?? 0,
}));
---

<Layout title="IP DEVELOPMENT — Hooking Point">
	<div class="hero-band">
		<span class="blob blob-1" aria-hidden="true"></span>
		<span class="blob blob-2" aria-hidden="true"></span>
		<div class="hero-band-inner">
			<h1>IP DEVELOPMENT</h1>
		</div>
	</div>

	<div class="page">
		<p class="intro">프로젝트별 AI 제작 도구입니다. 회의 녹음/자동 요약, 시나리오 3막 구조 분석, 레퍼런스 추천, 컨셉 이미지 생성을 프로젝트마다 로그인 없이 바로 사용할 수 있습니다.</p>

		<nav class="view-tabs" role="tablist">
			<button type="button" data-view="list" class="view-tab active">목록</button>
			<button type="button" data-view="board" class="view-tab">보드</button>
			<button type="button" data-view="timeline" class="view-tab">타임라인</button>
		</nav>

		<div class="toolbar">
			<input type="text" id="ip-search" placeholder="제목·장르 검색" />
			<select id="ip-sort">
				<option value="sortOrder">정렬 순서</option>
				<option value="year-desc">연도 최신순</option>
				<option value="year-asc">연도 오래된순</option>
				<option value="title">제목 가나다순</option>
			</select>
			<div class="stage-filters" id="ip-stage-filters">
				<button type="button" class="stage-filter active" data-stage="전체">전체</button>
				{STAGES.map((s) => (
					<button type="button" class="stage-filter" data-stage={s}>{s}</button>
				))}
			</div>
		</div>

		<div id="view-list" class="view-panel active"></div>
		<div id="view-board" class="view-panel"></div>
		<div id="view-timeline" class="view-panel"></div>

		<script type="application/json" id="ip-projects-data" set:html={JSON.stringify(projectsData)} />
	</div>
</Layout>

<script>
	import { supabase } from '../lib/supabase';

	const STAGES = ['기획', '트리트먼트', '대본', '개발', '피칭'];
	let projects = JSON.parse(document.getElementById('ip-projects-data')?.textContent || '[]');
	let isAdmin = false;

	let currentView = 'list';
	let currentStage = '전체';
	let currentSort = 'sortOrder';
	let currentSearch = '';

	function escapeHtml(s) {
		return String(s ?? '').replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));
	}

	async function refreshFromDb() {
		const { data, error } = await supabase
			.from('ip_projects')
			.select('id, title, genre, stage, year, target_date, sort_order')
			.order('sort_order', { ascending: true });
		if (!error && data) {
			projects = data.map((row) => ({
				id: row.id,
				title: row.title,
				genre: row.genre,
				stage: row.stage,
				year: row.year,
				targetDate: row.target_date,
				sortOrder: row.sort_order,
			}));
		}

		const { data: { session } } = await supabase.auth.getSession();
		if (session) {
			const { data: profile } = await supabase.from('profiles').select('role').eq('id', session.user.id).single();
			isAdmin = profile?.role === 'admin';
		} else {
			isAdmin = false;
		}

		renderAll();
	}

	function getFiltered() {
		let list = projects.filter((p) => currentStage === '전체' || p.stage === currentStage);
		if (currentSearch.trim()) {
			const q = currentSearch.trim().toLowerCase();
			list = list.filter((p) => p.title.toLowerCase().includes(q) || p.genre.toLowerCase().includes(q));
		}
		list = [...list];
		if (currentSort === 'year-desc') list.sort((a, b) => (b.year ?? 0) - (a.year ?? 0));
		else if (currentSort === 'year-asc') list.sort((a, b) => (a.year ?? 0) - (b.year ?? 0));
		else if (currentSort === 'title') list.sort((a, b) => a.title.localeCompare(b.title, 'ko'));
		else list.sort((a, b) => a.sortOrder - b.sortOrder);
		return list;
	}

	function cardHtml(p) {
		return `
			<a class="ip-card" href="/ip-development/${p.id}">
				<span class="stage-badge">${escapeHtml(p.stage)}</span>
				<span class="ip-title">${escapeHtml(p.title)}</span>
				<span class="ip-genre">${escapeHtml(p.genre)}</span>
			</a>
		`;
	}

	function renderList() {
		const el = document.getElementById('view-list');
		const list = getFiltered();
		el.innerHTML = list.length
			? `<ul class="ip-grid">${list.map((p) => `<li>${cardHtml(p)}</li>`).join('')}</ul>`
			: `<p class="hint">조건에 맞는 프로젝트가 없습니다.</p>`;
	}

	function renderBoard() {
		const el = document.getElementById('view-board');
		const list = getFiltered();
		el.innerHTML = `
			${isAdmin ? `<p class="hint drag-hint">카드를 드래그해서 다른 단계로 옮기면 바로 반영됩니다.</p>` : ''}
			<div class="board">
				${STAGES.map((stage) => {
					const items = list.filter((p) => p.stage === stage);
					return `
						<div class="board-col">
							<h3>${stage} <span class="board-count">${items.length}</span></h3>
							<div class="board-items" data-stage-drop="${stage}">
								${items.map((p) => `
									<a class="board-card" href="/ip-development/${p.id}" data-id="${p.id}" draggable="${isAdmin}">
										<span class="ip-title">${escapeHtml(p.title)}</span>
										<span class="ip-genre">${escapeHtml(p.genre)}</span>
									</a>
								`).join('') || `<p class="hint">없음</p>`}
							</div>
						</div>
					`;
				}).join('')}
			</div>
		`;
		if (isAdmin) attachBoardDnD();
	}

	function renderTimeline() {
		const el = document.getElementById('view-timeline');
		const list = getFiltered();
		const withDate = list.filter((p) => p.targetDate).sort((a, b) => a.targetDate.localeCompare(b.targetDate));
		const withoutDate = list.filter((p) => !p.targetDate);

		const groups = new Map();
		withDate.forEach((p) => {
			const key = p.targetDate.slice(0, 7);
			if (!groups.has(key)) groups.set(key, []);
			groups.get(key).push(p);
		});

		const groupHtml = [...groups.entries()].map(([month, items]) => `
			<div class="timeline-group" data-month-drop="${month}">
				<h3>${month.replace('-', '년 ')}월</h3>
				${items.map((p) => `
					<a class="timeline-item" href="/ip-development/${p.id}" data-id="${p.id}" draggable="${isAdmin}">
						<span class="timeline-date">${p.targetDate}</span>
						<span class="stage-badge">${escapeHtml(p.stage)}</span>
						<span class="ip-title">${escapeHtml(p.title)}</span>
					</a>
				`).join('')}
			</div>
		`).join('');

		const unscheduledHtml = `
			<div class="timeline-group" data-month-drop="">
				<h3>목표일 미정</h3>
				${withoutDate.map((p) => `
					<a class="timeline-item" href="/ip-development/${p.id}" data-id="${p.id}" draggable="${isAdmin}">
						<span class="timeline-date">-</span>
						<span class="stage-badge">${escapeHtml(p.stage)}</span>
						<span class="ip-title">${escapeHtml(p.title)}</span>
					</a>
				`).join('') || (isAdmin ? `<p class="hint">여기로 드래그하면 목표일이 지워집니다.</p>` : '')}
			</div>
		`;

		el.innerHTML = `
			${isAdmin ? `<p class="hint drag-hint">카드를 다른 달로 드래그하면 목표일이 그 달로 바뀝니다 (날짜는 15일로 지정). "목표일 미정"으로 드래그하면 지워집니다.</p>` : ''}
			${(list.length ? (groupHtml + unscheduledHtml) : `<p class="hint">조건에 맞는 프로젝트가 없습니다.</p>`)}
		`;
		if (isAdmin) attachTimelineDnD();
	}

	function attachBoardDnD() {
		document.querySelectorAll('.board-card').forEach((card) => {
			card.addEventListener('dragstart', (e) => {
				e.dataTransfer.setData('text/plain', card.dataset.id);
				e.dataTransfer.effectAllowed = 'move';
			});
		});
		document.querySelectorAll('.board-items').forEach((col) => {
			col.addEventListener('dragover', (e) => {
				e.preventDefault();
				col.classList.add('drag-over');
			});
			col.addEventListener('dragleave', () => col.classList.remove('drag-over'));
			col.addEventListener('drop', async (e) => {
				e.preventDefault();
				col.classList.remove('drag-over');
				const id = e.dataTransfer.getData('text/plain');
				const newStage = col.dataset.stageDrop;
				const project = projects.find((p) => p.id === id);
				if (!project || project.stage === newStage) return;
				const { error } = await supabase.from('ip_projects').update({ stage: newStage }).eq('id', id);
				if (error) {
					alert(`단계 변경 실패: ${error.message}`);
					return;
				}
				project.stage = newStage;
				renderAll();
			});
		});
	}

	function attachTimelineDnD() {
		document.querySelectorAll('.timeline-item').forEach((item) => {
			item.addEventListener('dragstart', (e) => {
				e.dataTransfer.setData('text/plain', item.dataset.id);
				e.dataTransfer.effectAllowed = 'move';
			});
		});
		document.querySelectorAll('.timeline-group').forEach((group) => {
			group.addEventListener('dragover', (e) => {
				e.preventDefault();
				group.classList.add('drag-over');
			});
			group.addEventListener('dragleave', () => group.classList.remove('drag-over'));
			group.addEventListener('drop', async (e) => {
				e.preventDefault();
				group.classList.remove('drag-over');
				const id = e.dataTransfer.getData('text/plain');
				const month = group.dataset.monthDrop;
				const project = projects.find((p) => p.id === id);
				if (!project) return;
				const newDate = month ? `${month}-15` : null;
				if (project.targetDate === newDate) return;
				const { error } = await supabase.from('ip_projects').update({ target_date: newDate }).eq('id', id);
				if (error) {
					alert(`목표일 변경 실패: ${error.message}`);
					return;
				}
				project.targetDate = newDate;
				renderAll();
			});
		});
	}

	function renderAll() {
		renderList();
		renderBoard();
		renderTimeline();
	}

	document.querySelectorAll('.view-tab').forEach((btn) => {
		btn.addEventListener('click', () => {
			document.querySelectorAll('.view-tab').forEach((b) => b.classList.remove('active'));
			btn.classList.add('active');
			currentView = btn.dataset.view;
			document.querySelectorAll('.view-panel').forEach((p) => p.classList.remove('active'));
			document.getElementById(`view-${currentView}`)?.classList.add('active');
		});
	});

	document.querySelectorAll('.stage-filter').forEach((btn) => {
		btn.addEventListener('click', () => {
			document.querySelectorAll('.stage-filter').forEach((b) => b.classList.remove('active'));
			btn.classList.add('active');
			currentStage = btn.dataset.stage;
			renderAll();
		});
	});

	document.getElementById('ip-sort')?.addEventListener('change', (e) => {
		currentSort = e.target.value;
		renderAll();
	});

	document.getElementById('ip-search')?.addEventListener('input', (e) => {
		currentSearch = e.target.value;
		renderAll();
	});

	renderAll();
	refreshFromDb();
</script>

<style is:global>
	.hero-band {
		position: relative;
		overflow: hidden;
		background: linear-gradient(135deg, #0f2fa8, var(--accent) 60%, #2e64f2);
		padding: 1.75rem 2rem;
		margin-bottom: 2.5rem;
	}
	.hero-band-inner {
		position: relative;
		z-index: 1;
		max-width: 1100px;
		margin-inline: auto;
	}
	.hero-band h1 {
		margin: 0;
		font-size: 1.7rem;
		color: #fff;
	}
	.blob {
		position: absolute;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.08);
		filter: blur(2px);
	}
	.blob-1 {
		width: 220px;
		height: 220px;
		top: -160px;
		right: 8%;
	}
	.blob-2 {
		width: 160px;
		height: 160px;
		bottom: -130px;
		right: 24%;
		background: rgba(255, 255, 255, 0.06);
	}

	.intro {
		color: var(--muted);
		max-width: 40rem;
		margin: 0 0 2rem;
	}

	.view-tabs {
		display: flex;
		gap: 0.3rem;
		border-bottom: 1px solid var(--border);
		margin-bottom: 1.5rem;
	}
	.view-tab {
		font: inherit;
		border: none;
		background: none;
		color: var(--muted);
		padding: 0.6rem 0.9rem;
		font-size: 0.85rem;
		font-weight: 600;
		cursor: pointer;
		border-bottom: 2px solid transparent;
	}
	.view-tab.active {
		color: var(--heading);
		border-bottom-color: var(--accent);
	}

	.toolbar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem;
		margin-bottom: 2rem;
	}
	.toolbar input,
	.toolbar select {
		font: inherit;
		font-size: 0.85rem;
		padding: 0.5rem 0.8rem;
		border: 1px solid var(--border);
		border-radius: 6px;
		background: var(--surface);
		color: var(--fg);
	}
	.toolbar input {
		min-width: 200px;
	}
	.stage-filters {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}
	.stage-filter {
		font: inherit;
		font-size: 0.8rem;
		font-weight: 600;
		background: none;
		border: none;
		color: var(--muted);
		border-radius: 999px;
		padding: 0.4rem 0.9rem;
		cursor: pointer;
	}
	.stage-filter:hover {
		color: var(--heading);
	}
	.stage-filter.active {
		background: var(--surface-strong);
		color: var(--heading);
	}

	.view-panel {
		display: none;
	}
	.view-panel.active {
		display: block;
	}

	.hint {
		color: var(--muted);
		font-size: 0.9rem;
	}

	.ip-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
		gap: 1.5rem;
	}
	.ip-card {
		font: inherit;
		text-align: left;
		width: 100%;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 10px;
		padding: 1.5rem;
		cursor: pointer;
		color: inherit;
		display: flex;
		flex-direction: column;
		box-shadow: var(--shadow);
		transition: border-color 0.15s ease, box-shadow 0.15s ease, transform 0.15s ease;
	}
	.ip-card:hover {
		border-color: var(--accent);
		box-shadow: var(--shadow-hover);
		transform: translateY(-2px);
	}
	.stage-badge {
		align-self: flex-start;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		color: var(--heading);
		border: 1px solid var(--accent);
		background: var(--accent-dim);
		border-radius: 999px;
		padding: 0.2rem 0.6rem;
		margin-bottom: 0.8rem;
	}
	.ip-title {
		font-weight: 700;
		color: var(--heading);
		margin-bottom: 0.2rem;
	}
	.ip-genre {
		font-size: 0.85rem;
		color: var(--muted);
	}

	.board {
		display: grid;
		grid-template-columns: repeat(5, minmax(180px, 1fr));
		gap: 1rem;
		overflow-x: auto;
	}
	.board-col h3 {
		font-size: 0.85rem;
		color: var(--heading);
		margin: 0 0 0.8rem;
		display: flex;
		align-items: center;
		gap: 0.4rem;
	}
	.board-count {
		font-size: 0.7rem;
		font-weight: 400;
		color: var(--muted);
	}
	.board-items {
		display: flex;
		flex-direction: column;
		gap: 0.6rem;
		min-height: 3rem;
		border-radius: 8px;
		transition: background-color 0.15s ease;
	}
	.board-items.drag-over {
		background: var(--accent-dim);
	}
	.board-card {
		display: flex;
		flex-direction: column;
		gap: 0.15rem;
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 8px;
		padding: 0.8rem;
		color: inherit;
		transition: border-color 0.15s ease;
	}
	.board-card:hover {
		border-color: var(--accent);
	}
	.board-card[draggable='true'] {
		cursor: grab;
	}
	.drag-hint {
		margin: 0 0 1rem;
	}
	.board-card .ip-title {
		font-size: 0.85rem;
		margin: 0;
	}
	.board-card .ip-genre {
		font-size: 0.75rem;
	}

	.timeline-group {
		margin-bottom: 1.8rem;
		border-radius: 8px;
		transition: background-color 0.15s ease;
	}
	.timeline-group.drag-over {
		background: var(--accent-dim);
	}
	.timeline-group h3 {
		font-size: 0.9rem;
		color: var(--heading);
		margin: 0 0 0.7rem;
		padding-bottom: 0.4rem;
		border-bottom: 1px solid var(--border);
	}
	.timeline-item {
		display: flex;
		align-items: center;
		gap: 0.8rem;
		padding: 0.6rem 0;
		color: inherit;
		border-bottom: 1px dashed var(--border);
	}
	.timeline-item[draggable='true'] {
		cursor: grab;
	}
	.timeline-item:last-child {
		border-bottom: none;
	}
	.timeline-item:hover .ip-title {
		color: var(--accent);
	}
	.timeline-date {
		font-size: 0.8rem;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
		flex-shrink: 0;
		width: 5.5rem;
	}
</style>
