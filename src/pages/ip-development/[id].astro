---
import Layout from '../../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
	const projects = await getCollection('ipProjects');
	return projects.map((p) => ({ params: { id: p.id } }));
}

const { id } = Astro.params;
const project = await getEntry('ipProjects', id);
const { title, genre, stage, logline, mainWriter, year, award, concept, material, customFields } = project.data;

const infoFields = [
	{ label: '메인작가', value: mainWriter },
	{ label: '구분', value: stage },
	{ label: '년도', value: year },
	{ label: '수상', value: award },
	{ label: '컨셉', value: concept },
	{ label: '소재', value: material },
	...Object.entries(customFields ?? {}).map(([label, value]) => ({ label, value })),
];
---

<Layout title={`${title} — IP정보 — Hooking Point`}>
	<div class="page" data-project-id={id} data-project-title={title}>
		<a class="back-link" href="/ip-development">← IP정보 목록으로</a>

		<span class="ip-genre">[{genre}]</span>
		<h1>{title}</h1>
		<p class="logline">{logline}</p>

		<div class="info-block">
			<h2>IP 작품정보</h2>
			<ul class="info-fields">
				{infoFields.map((f) => (
					<li><span class="field-label">{f.label}</span><span class="field-value">{f.value ?? '-'}</span></li>
				))}
			</ul>
		</div>

		<div class="synopsis-block">
			<h2>로그라인</h2>
			<div id="detail-protected">확인 중…</div>
		</div>
	</div>
</Layout>

<script>
	import { supabase } from '../../lib/supabase';

	const page = document.querySelector('.page') as HTMLElement;
	const projectId = page.dataset.projectId!;
	const projectTitle = page.dataset.projectTitle!;

	const protectedEl = document.getElementById('detail-protected');

	function escapeHtml(s: string) {
		return s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' } as Record<string, string>)[c]);
	}

	function withLineBreaks(s: string) {
		return escapeHtml(s).replace(/\n/g, '<br />');
	}

	function requestAccessHtml(message: string) {
		const mailto = `mailto:hooking.point@gmail.com?subject=${encodeURIComponent(`[${projectTitle}] 열람 요청`)}`;
		return `<p class="hint">${message} 해당 작품에 대해 더 알고 싶은 분은 <a href="${mailto}">hooking.point@gmail.com</a>로 열람 요청 주세요.</p>`;
	}

	async function loadProtectedDetail() {
		if (!protectedEl) return;

		const { data: { session } } = await supabase.auth.getSession();
		if (!session) {
			protectedEl.innerHTML = requestAccessHtml('로그인한 회원 중 관리자로부터 열람 권한을 부여받은 분만 확인할 수 있습니다.');
			return;
		}

		const { data: profile } = await supabase
			.from('profiles')
			.select('role, ip_access')
			.eq('id', session.user.id)
			.single();

		const allowed = !!profile && (profile.role === 'admin' || profile.ip_access === true);
		if (!allowed) {
			protectedEl.innerHTML = requestAccessHtml('열람 권한이 없습니다.');
			return;
		}

		const { data, error } = await supabase
			.from('ip_project_synopses')
			.select('synopsis, planning_intent, key_images')
			.eq('project_id', projectId)
			.maybeSingle();

		if (error || !data) {
			protectedEl.innerHTML = `<p class="hint">아직 등록된 상세정보가 없습니다.</p>`;
			return;
		}

		const images: string[] = Array.isArray(data.key_images) ? data.key_images : [];

		protectedEl.innerHTML = `
			<div class="detail-section"><h3>시놉시스</h3><p>${data.synopsis ? withLineBreaks(data.synopsis) : '(작성 예정)'}</p></div>
			<div class="detail-section"><h3>기획의도</h3><p>${data.planning_intent ? withLineBreaks(data.planning_intent) : '(작성 예정)'}</p></div>
			${images.length ? `<div class="detail-section"><h3>주요 이미지</h3><div class="key-images">${images.map((src) => `<img src="${escapeHtml(src)}" alt="" loading="lazy" />`).join('')}</div></div>` : ''}
		`;
	}
	loadProtectedDetail();
</script>

<style>
	h1 {
		margin: 0.6rem 0 0.3rem;
	}
	.ip-genre {
		display: block;
		font-size: 0.85rem;
		font-weight: 700;
		color: var(--accent);
		margin: 0 0 0.3rem;
	}
	.logline {
		line-height: 1.6;
		max-width: 40rem;
		margin: 0 0 1.5rem;
		color: var(--muted);
	}

	.info-block,
	.synopsis-block {
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: 10px;
		padding: 1.5rem;
		margin-bottom: 1.5rem;
		box-shadow: var(--shadow);
	}
	.info-block h2,
	.synopsis-block h2 {
		margin-top: 0;
		font-size: 1.05rem;
	}
	.synopsis-block p {
		line-height: 1.6;
	}
	.info-fields {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 0.6rem 1.5rem;
	}
	.info-fields li {
		display: flex;
		gap: 0.5rem;
		font-size: 0.9rem;
	}
	.info-fields .field-label {
		color: var(--muted);
		flex-shrink: 0;
	}
	.info-fields .field-value {
		color: var(--fg);
	}
	.detail-section {
		margin-bottom: 1.5rem;
	}
	.detail-section:last-child {
		margin-bottom: 0;
	}
	.detail-section h3 {
		font-size: 0.95rem;
		color: var(--heading);
		margin: 0 0 0.5rem;
	}
	.key-images {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
		gap: 0.75rem;
	}
	.key-images img {
		width: 100%;
		height: auto;
		border-radius: 8px;
		border: 1px solid var(--border);
		display: block;
	}

</style>
