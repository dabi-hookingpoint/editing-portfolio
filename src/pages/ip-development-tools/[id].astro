---
import Layout from '../../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
	const projects = await getCollection('ipProjects');
	return projects.map((p) => ({ params: { id: p.id } }));
}

const { id } = Astro.params;
const project = await getEntry('ipProjects', id);
const { title, genre, stage } = project.data;
---

<Layout title={`${title} — IP DEVELOPMENT — Hooking Point`}>
	<div class="page" data-project-id={id} data-project-title={title}>
		<a class="back-link" href="/ip-development-tools">← IP DEVELOPMENT 목록으로</a>

		<span class="stage-badge">{stage}</span>
		<h1>{title}</h1>
		<p class="ip-genre">{genre}</p>

		<section class="tools-section">
			<h2>AI 도구</h2>

			<nav class="tool-tabs">
				<button type="button" data-tab="record" class="tab-btn active">① 회의 녹음/저장</button>
				<button type="button" data-tab="analyze" class="tab-btn">② 구조 분석 · 레퍼런스</button>
				<button type="button" data-tab="image" class="tab-btn">③ 컨셉 이미지</button>
				<button type="button" data-tab="checklist" class="tab-btn">④ 체크리스트</button>
				<button type="button" data-tab="comments" class="tab-btn">⑤ 댓글</button>
				<button type="button" data-tab="activity" class="tab-btn">⑥ 활동 기록</button>
			</nav>

			<section class="tool-panel active" id="panel-record">
				<div class="tool-card">
					<div class="form-row">
						<div class="field"><label>감독/상대</label><input type="text" id="rec-director" placeholder="예: OO 감독" /></div>
						<div class="field"><label>회의 날짜</label><input type="date" id="rec-date" /></div>
					</div>
					<div class="form-actions">
						<button type="button" class="rec-toggle-btn" id="rec-toggle">● 녹음 시작</button>
						<button type="button" class="cancel-btn" id="rec-clear">지우기</button>
					</div>
					<textarea id="rec-text" rows="6" placeholder="녹음 시작 후 말하면 실시간으로 텍스트가 쌓입니다. 말이 1.5초 이상 끊기면 자동으로 화자(A, B)가 전환됩니다(무료 방식 — 정확하지 않을 수 있어요). 직접 타이핑해서 수정해도 됩니다."></textarea>
					<p class="hint" id="rec-hint">크롬(Chrome) 브라우저에서만 지원됩니다. 마이크 권한을 허용해주세요.</p>
					<div class="form-actions">
						<button type="button" class="save-btn" id="rec-save">이 내용 저장 (저장 시 AI 요약 자동 생성)</button>
					</div>
				</div>
				<div class="tool-card">
					<h2>저장된 회의 기록 — 이 프로젝트</h2>
					<div id="rec-list"></div>
				</div>
			</section>

			<section class="tool-panel" id="panel-analyze">
				<div class="tool-card">
					<label class="field-label" for="an-text">시나리오/시놉시스 텍스트 (씬·문단 사이는 빈 줄로 구분)</label>
					<textarea id="an-text" rows="10"></textarea>
					<div class="form-actions">
						<button type="button" class="save-btn" id="an-run">3막 구조 분석하기</button>
						<button type="button" class="save-btn accent" id="ref-run">레퍼런스 작품 추천받기</button>
					</div>
				</div>
				<div class="tool-card" id="an-result" hidden></div>
				<div class="tool-card" id="ref-result" hidden></div>
				<div class="tool-card">
					<h2>저장된 레퍼런스 — 이 프로젝트</h2>
					<div id="saved-ref-list"></div>
				</div>
			</section>

			<section class="tool-panel" id="panel-image">
				<div class="tool-card">
					<label class="field-label" for="im-prompt">씬 설명 / 컨셉 프롬프트</label>
					<textarea id="im-prompt" rows="4" placeholder="예: 비 내리는 도심 골목, 네온사인 반사, 느와르 톤, 영화적 조명"></textarea>
					<p class="hint">문장으로 길게 쓰기보다, 장소·인물·행동·분위기 등 핵심 키워드를 쉼표로 나열하면 더 정확한 이미지가 나옵니다.</p>
					<div class="form-actions">
						<button type="button" class="save-btn" id="im-run">컨셉 이미지 생성</button>
					</div>
					<p class="hint" id="im-hint"></p>
				</div>
				<div class="tool-card" id="im-result" hidden></div>
			</section>

			<section class="tool-panel" id="panel-checklist">
				<div class="tool-card">
					<h2>체크리스트</h2>
					<div class="form-row" id="task-add-row" style="display: none;">
						<div class="field" style="flex: 3;">
							<label for="task-input">할 일</label>
							<input type="text" id="task-input" placeholder="예: 트리트먼트 2차 수정" />
						</div>
						<div class="field">
							<label for="task-assignee">담당자</label>
							<select id="task-assignee"><option value="">미지정</option></select>
						</div>
					</div>
					<div class="form-actions" id="task-add-actions" style="display: none;">
						<button type="button" class="save-btn" id="task-add-btn">추가</button>
					</div>
					<div id="task-list"></div>
				</div>
			</section>

			<section class="tool-panel" id="panel-comments">
				<div class="tool-card">
					<h2>댓글 / 업데이트</h2>
					<p class="hint">회의 없이도 근황을 남길 수 있는 공간입니다. "@아이디"로 팀원을 멘션하면 알림이 갑니다.</p>
					<div class="form-row" id="comment-add-row" style="display: none;">
						<div class="field" style="flex: 1;">
							<label for="comment-input">댓글 남기기</label>
							<textarea id="comment-input" rows="3" placeholder="예: @다비 트리트먼트 2차 수정 초안 올렸습니다, 확인 부탁드려요"></textarea>
						</div>
					</div>
					<div class="form-actions" id="comment-add-actions" style="display: none;">
						<button type="button" class="save-btn" id="comment-add-btn">댓글 등록</button>
					</div>
					<div id="comment-list"></div>
				</div>
			</section>

			<section class="tool-panel" id="panel-activity">
				<div class="tool-card">
					<h2>활동 기록</h2>
					<p class="hint">단계 변경, 할 일 생성/완료/삭제, 댓글, 레퍼런스 저장이 자동으로 기록됩니다.</p>
					<div id="activity-list"></div>
				</div>
			</section>
		</section>
	</div>
</Layout>

<script>
	import { supabase } from '../../lib/supabase';

	// 로컬스토리지 기반 회의 기록 저장은 유지 중입니다(추후 pd_meeting_transcripts 테이블로 전환 예정).

	const projectId = (document.querySelector('.page') as HTMLElement).dataset.projectId!;
	const projectTitle = (document.querySelector('.page') as HTMLElement).dataset.projectTitle!;
	const LOCAL_TRANSCRIPTS_KEY = `pd_meeting_transcripts_${projectId}`;

	function requestAccessHtml(message: string) {
		const mailto = `mailto:hooking.point@gmail.com?subject=${encodeURIComponent(`[${projectTitle}] 권한 요청`)}`;
		return `<p class="hint">${message} 권한이 필요하시면 <a href="${mailto}">hooking.point@gmail.com</a>로 문의해주세요.</p>`;
	}

	async function loadTeamAccess() {
		const { data: { session } } = await supabase.auth.getSession();
		if (!session) return { canRead: false, canWrite: false };
		const { data: profile } = await supabase
			.from('profiles')
			.select('role, ai_tools_access')
			.eq('id', session.user.id)
			.single();
		if (!profile) return { canRead: false, canWrite: false };
		const allowed = profile.role === 'admin' || profile.ai_tools_access === true;
		return { canRead: allowed, canWrite: allowed };
	}

	let teamMembersCache = null;
	async function loadTeamMembers() {
		if (teamMembersCache) return teamMembersCache;
		const { data, error } = await supabase.rpc('list_team_members');
		teamMembersCache = error ? [] : data;
		return teamMembersCache;
	}

	checkAccessAndInit();

	async function checkAccessAndInit() {
		// 로그인 없이 누구나 사용할 수 있도록 열어둔 상태입니다.
		initTools();
	}

	function initTools() {
		initTabs();
		initStatusBadges();
		initRecordTab();
		initAnalyzeTab();
		initImageTab();
		initChecklistTab();
		initCommentsTab();
		loadActivity();
		loadTranscripts();
		loadSavedReferences();
	}

	// ---- tabs ----
	function initTabs() {
		const tabButtons = document.querySelectorAll('.tab-btn');
		const panels = {
			record: document.getElementById('panel-record'),
			analyze: document.getElementById('panel-analyze'),
			image: document.getElementById('panel-image'),
			checklist: document.getElementById('panel-checklist'),
			comments: document.getElementById('panel-comments'),
			activity: document.getElementById('panel-activity'),
		};
		tabButtons.forEach((btn) => {
			btn.addEventListener('click', () => {
				tabButtons.forEach((b) => b.classList.remove('active'));
				btn.classList.add('active');
				Object.values(panels).forEach((p) => p?.classList.remove('active'));
				const key = btn.dataset.tab ?? '';
				panels[key]?.classList.add('active');
			});
		});
	}

	async function authHeaders() {
		const { data: { session } } = await supabase.auth.getSession();
		const headers = { 'content-type': 'application/json' };
		if (session?.access_token) headers.authorization = `Bearer ${session.access_token}`;
		return headers;
	}

	async function apiCall(path, body) {
		const res = await fetch(path, {
			method: 'POST',
			headers: await authHeaders(),
			body: JSON.stringify(body),
		});
		const data = await res.json();
		if (!res.ok) throw new Error(data?.error || `요청 실패 (${res.status})`);
		return data;
	}

	async function initStatusBadges() {
		try {
			const res = await fetch('/api/status', { headers: await authHeaders() });
			const data = await res.json();
			if (!res.ok) throw new Error(data?.error || `요청 실패 (${res.status})`);
			const imHint = document.getElementById('im-hint');
			if (imHint) {
				if (data.imageEngine === 'mock') {
					imHint.textContent = '현재 이미지 생성 엔진이 설정되지 않아 목업(그라디언트) 이미지로 대체됩니다.';
				} else if (data.imageEngine === 'workers-ai') {
					imHint.textContent = 'Cloudflare Workers AI(무료)로 실제 이미지를 생성합니다.';
				} else if (data.imageEngine === 'colab') {
					imHint.textContent = 'Colab GPU에서 실행 중인 Stable Diffusion으로 이미지를 생성합니다. 노트북이 꺼져 있으면 목업으로 대체됩니다.';
				} else {
					imHint.textContent = `${data.imageEngine} API로 실제 이미지를 생성합니다.`;
				}
			}
		} catch {
			// 상태 배지는 참고용이라 실패해도 조용히 무시
		}
	}

	// ---- record tab (+ 무료 화자 자동구분: 침묵 기반 추정) ----
	function initRecordTab() {
		const recText = document.getElementById('rec-text');
		const recToggle = document.getElementById('rec-toggle');
		const recHint = document.getElementById('rec-hint');

		const PAUSE_THRESHOLD_MS = 1500;
		let recognition = null;
		let recognizing = false;
		let baseText = '';
		let currentSpeaker = 'A';
		let lastFinalAt = 0;

		const SpeechRecognitionImpl = window.SpeechRecognition || window.webkitSpeechRecognition;

		function appendFinal(text) {
			const now = Date.now();
			if (lastFinalAt && now - lastFinalAt > PAUSE_THRESHOLD_MS) {
				currentSpeaker = currentSpeaker === 'A' ? 'B' : 'A';
			}
			lastFinalAt = now;
			baseText += (baseText ? '\n\n' : '') + `[화자 ${currentSpeaker}] ` + text;
		}

		if (!SpeechRecognitionImpl) {
			recToggle.disabled = true;
			if (recHint) recHint.textContent = '이 브라우저는 음성인식(Web Speech API)을 지원하지 않습니다. 크롬(Chrome)에서 열어주세요. 직접 타이핑은 가능합니다.';
		} else {
			recognition = new SpeechRecognitionImpl();
			recognition.lang = 'ko-KR';
			recognition.continuous = true;
			recognition.interimResults = true;

			recognition.onresult = (event) => {
				let finalChunk = '';
				let interimChunk = '';
				for (let i = event.resultIndex; i < event.results.length; i++) {
					const transcript = event.results[i][0].transcript;
					if (event.results[i].isFinal) finalChunk += transcript;
					else interimChunk += transcript;
				}
				if (finalChunk) appendFinal(finalChunk.trim());
				recText.value = baseText + (interimChunk ? ` [${interimChunk}]` : '');
			};
			recognition.onerror = (e) => {
				if (recHint) recHint.textContent = `음성인식 오류: ${e.error}. 마이크 권한을 확인해주세요.`;
			};
			recognition.onend = () => {
				if (recognizing) recognition.start();
			};
		}

		recToggle.addEventListener('click', () => {
			if (!recognition) return;
			if (!recognizing) {
				baseText = recText.value;
				lastFinalAt = 0;
				currentSpeaker = 'A';
				recognizing = true;
				recognition.start();
				recToggle.textContent = '■ 녹음 중지';
				recToggle.classList.add('on');
				if (recHint) recHint.textContent = '듣고 있습니다... 말이 1.5초 이상 끊기면 자동으로 화자가 전환됩니다 (무료 방식이라 정확하지 않을 수 있어요 — 필요하면 직접 수정하세요).';
			} else {
				recognizing = false;
				recognition.stop();
				recToggle.textContent = '● 녹음 시작';
				recToggle.classList.remove('on');
				if (recHint) recHint.textContent = '녹음이 중지되었습니다.';
			}
		});

		document.getElementById('rec-clear')?.addEventListener('click', () => {
			baseText = '';
			lastFinalAt = 0;
			recText.value = '';
		});

		document.getElementById('rec-save')?.addEventListener('click', async () => {
			const text = recText.value.trim();
			if (!text) return;
			const director = document.getElementById('rec-director').value || '미지정';
			const date = document.getElementById('rec-date').value || '';
			const record = saveTranscriptLocal({ director, date, content: text, char_count: text.length });
			recText.value = '';
			baseText = '';
			lastFinalAt = 0;
			document.getElementById('rec-date').value = '';
			await loadTranscripts();
			document.querySelector(`.summarize-btn[data-id="${record.id}"]`)?.click();
		});
	}

	function readTranscriptsLocal() {
		try {
			return JSON.parse(localStorage.getItem(LOCAL_TRANSCRIPTS_KEY) || '[]');
		} catch {
			return [];
		}
	}

	function saveTranscriptLocal(entry) {
		const records = readTranscriptsLocal();
		const record = {
			id: `local_${Date.now()}_${Math.floor(Math.random() * 1e6)}`,
			created_at: new Date().toISOString(),
			...entry,
		};
		records.push(record);
		localStorage.setItem(LOCAL_TRANSCRIPTS_KEY, JSON.stringify(records));
		return record;
	}

	function deleteTranscriptLocal(id) {
		const records = readTranscriptsLocal().filter((r) => r.id !== id);
		localStorage.setItem(LOCAL_TRANSCRIPTS_KEY, JSON.stringify(records));
	}

	async function loadTranscripts() {
		const list = document.getElementById('rec-list');
		if (!list) return;
		const data = readTranscriptsLocal().sort((a, b) => (a.created_at < b.created_at ? 1 : -1));

		if (data.length === 0) {
			list.innerHTML = `<p class="hint">아직 저장된 기록이 없습니다. (이 브라우저 · 이 프로젝트에만 저장됩니다 — 로그인 연동 전 임시 방식입니다.)</p>`;
			return;
		}

		list.innerHTML = data.map((r) => `
			<div class="list-item" data-id="${r.id}">
				<span class="item-title">
					${r.director}
					<small class="item-meta">${r.date ? `회의일 ${r.date} · ` : ''}저장 ${new Date(r.created_at).toLocaleString('ko-KR')} · ${r.char_count}자</small>
					<span class="item-text">${escapeHtml(r.content).slice(0, 200)}${r.content.length > 200 ? '…' : ''}</span>
					<span class="item-summary" id="summary-${r.id}" hidden></span>
				</span>
				<span class="item-actions">
					<button class="summarize-btn" data-id="${r.id}">요약하기</button>
					<button class="delete-btn" data-id="${r.id}">삭제</button>
				</span>
			</div>
		`).join('');

		list.querySelectorAll('.delete-btn').forEach((btn) => {
			btn.onclick = () => {
				if (btn.dataset.id) deleteTranscriptLocal(btn.dataset.id);
				loadTranscripts();
			};
		});

		list.querySelectorAll('.summarize-btn').forEach((btn) => {
			btn.onclick = async () => {
				const record = data.find((r) => r.id === btn.dataset.id);
				const summaryBox = document.getElementById(`summary-${btn.dataset.id}`);
				if (!record || !summaryBox) return;
				btn.disabled = true;
				btn.textContent = '요약 중...';
				try {
					const result = await apiCall('/api/summarize', { text: record.content });
					summaryBox.hidden = false;
					summaryBox.innerHTML = `
						<span class="badge">엔진: ${result.engine}</span>
						<p>${result.summary || ''}</p>
						${result.keyPoints?.length ? `<ul class="issues plain">${result.keyPoints.map((k) => `<li>${k}</li>`).join('')}</ul>` : ''}
						${result.speakerNotes ? `<ul class="issues plain">${Object.entries(result.speakerNotes).map(([k, v]) => `<li><strong>화자 ${k}:</strong> ${v}</li>`).join('')}</ul>` : ''}
						${result.engineError ? `<p class="error-box">LLM 호출 실패로 휴리스틱 요약으로 대체됨: ${result.engineError}</p>` : ''}
					`;
				} catch (err) {
					summaryBox.hidden = false;
					summaryBox.innerHTML = `<p class="error-box">오류: ${err.message}</p>`;
				} finally {
					btn.disabled = false;
					btn.textContent = '요약하기';
				}
			};
		});
	}

	function escapeHtml(s) {
		return s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));
	}

	// ---- analyze + reference tab ----
	function initAnalyzeTab() {
		const anText = document.getElementById('an-text');
		const anResult = document.getElementById('an-result');
		const refResult = document.getElementById('ref-result');

		function actBlock(label, act, hitsKey) {
			const ratio = act?.ratio != null ? Math.round(act.ratio * 100) : null;
			const hits = act?.[hitsKey] || [];
			return `
				<div class="act-block">
					<h3>${label} ${ratio != null ? `<span class="muted">(분량 ${ratio}%)</span>` : ''}</h3>
					${ratio != null ? `<div class="bar-track"><div class="bar-fill" style="width:${ratio}%"></div></div>` : ''}
					${act?.summary ? `<p>${act.summary}</p>` : ''}
					${hits.length ? `<p class="hint">감지된 전환 표현: ${hits.join(', ')}</p>` : ''}
					${act?.issues?.length ? `<ul class="issues">${act.issues.map((i) => `<li>${i}</li>`).join('')}</ul>` : ''}
				</div>`;
		}

		document.getElementById('an-run')?.addEventListener('click', async () => {
			const text = anText.value.trim();
			if (!text) return;
			const btn = document.getElementById('an-run');
			btn.disabled = true;
			btn.textContent = '분석 중...';
			try {
				const data = await apiCall('/api/analyze', { text });
				anResult.hidden = false;
				if (data.warning) {
					anResult.innerHTML = `<p class="error-box">${data.warning}</p>`;
					return;
				}
				anResult.innerHTML = `
					<span class="badge">엔진: ${data.engine}</span>
					${actBlock('1막 · 설정', data.act1, 'turningPointHits')}
					${actBlock('2막 · 대립·전개', data.act2, 'midpointHits')}
					${actBlock('3막 · 해결', data.act3, 'resolutionHits')}
					${data.overallIssues?.length ? `<h3>전체 구조 문제점</h3><ul class="issues">${data.overallIssues.map((i) => `<li>${i}</li>`).join('')}</ul>` : ''}
					${data.recommendations?.length ? `<h3>수정 제안</h3><ul class="recs">${data.recommendations.map((i) => `<li>${i}</li>`).join('')}</ul>` : ''}
					${data.engineError ? `<p class="error-box">LLM 호출 실패로 휴리스틱 분석으로 대체됨: ${data.engineError}</p>` : ''}
				`;
			} catch (err) {
				anResult.hidden = false;
				anResult.innerHTML = `<p class="error-box">오류: ${err.message}</p>`;
			} finally {
				btn.disabled = false;
				btn.textContent = '3막 구조 분석하기';
			}
		});

		document.getElementById('ref-run')?.addEventListener('click', async () => {
			const text = anText.value.trim();
			if (!text) return;
			const btn = document.getElementById('ref-run');
			btn.disabled = true;
			btn.textContent = '추천 중...';
			try {
				const data = await apiCall('/api/references', { text });
				refResult.hidden = false;
				const refs = data.references || [];
				refResult.innerHTML = `
					<span class="badge">엔진: ${data.engine}</span>
					<h3>추천 레퍼런스 작품 (${refs.length}편)</h3>
					${refs.length ? `<ul class="issues plain">${refs.map((r, i) => `<li data-ref-idx="${i}"><strong>${r.title}</strong>${r.year ? ` (${r.year})` : ''} · ${r.type || ''}<div class="hint">${r.reason || ''}</div><button type="button" class="save-ref-btn" data-idx="${i}">이 프로젝트에 저장</button></li>`).join('')}</ul>` : `<p class="hint">추천 결과가 없습니다.</p>`}
					${data.detectedTags?.length ? `<p class="hint">감지된 키워드: ${data.detectedTags.join(', ')}</p>` : ''}
					${data.engineError ? `<p class="error-box">LLM 호출 실패로 큐레이션 DB 매칭으로 대체됨: ${data.engineError}</p>` : ''}
				`;
				refResult.querySelectorAll('.save-ref-btn').forEach((saveBtn) => {
					saveBtn.addEventListener('click', async () => {
						const ref = refs[Number(saveBtn.dataset.idx)];
						if (!ref) return;
						saveBtn.disabled = true;
						saveBtn.textContent = '저장 중...';
						const { error } = await supabase.from('ip_project_references').insert({
							project_id: projectId,
							work_title: ref.title,
							reason: ref.reason || '',
						});
						if (error) {
							saveBtn.disabled = false;
							saveBtn.textContent = `저장 실패 (${error.message})`;
						} else {
							saveBtn.textContent = '저장됨 ✓';
							loadSavedReferences();
						}
					});
				});
			} catch (err) {
				refResult.hidden = false;
				refResult.innerHTML = `<p class="error-box">오류: ${err.message}</p>`;
			} finally {
				btn.disabled = false;
				btn.textContent = '레퍼런스 작품 추천받기';
			}
		});
	}

	async function loadSavedReferences() {
		const list = document.getElementById('saved-ref-list');
		if (!list) return;

		const access = await loadTeamAccess();
		if (!access.canRead) {
			list.innerHTML = requestAccessHtml('로그인한 팀원 중 권한을 부여받은 분만 저장된 레퍼런스를 볼 수 있습니다.');
			return;
		}

		const { data, error } = await supabase
			.from('ip_project_references')
			.select('*')
			.eq('project_id', projectId)
			.order('created_at', { ascending: false });

		if (error) {
			list.innerHTML = `<p class="error-box">오류: ${error.message}</p>`;
			return;
		}
		if (!data || data.length === 0) {
			list.innerHTML = `<p class="hint">아직 저장된 레퍼런스가 없습니다.</p>`;
			return;
		}

		list.innerHTML = data.map((r) => `
			<div class="list-item" data-id="${r.id}">
				<span class="item-title">
					${escapeHtml(r.work_title)}
					${r.reason ? `<span class="item-text">${escapeHtml(r.reason)}</span>` : ''}
				</span>
				${access.canWrite ? `<span class="item-actions"><button class="delete-btn saved-ref-delete-btn" data-id="${r.id}">삭제</button></span>` : ''}
			</div>
		`).join('');

		if (access.canWrite) {
			list.querySelectorAll('.saved-ref-delete-btn').forEach((btn) => {
				btn.addEventListener('click', async () => {
					await supabase.from('ip_project_references').delete().eq('id', btn.dataset.id);
					loadSavedReferences();
				});
			});
		}
	}

	// ---- image tab ----
	function initImageTab() {
		document.getElementById('im-run')?.addEventListener('click', async () => {
			const prompt = document.getElementById('im-prompt').value.trim();
			if (!prompt) return;
			const btn = document.getElementById('im-run');
			const box = document.getElementById('im-result');
			btn.disabled = true;
			btn.textContent = '생성 중...';
			try {
				const data = await apiCall('/api/concept-image', { prompt });
				box.hidden = false;
				box.innerHTML = `
					<span class="badge">엔진: ${data.provider}</span><br/>
					<img class="concept-img" src="${data.url}" alt="concept image" />
					${data.finalPrompt ? `<p class="hint">실제 사용된 프롬프트: ${data.finalPrompt}</p>` : ''}
					${data.engineError ? `<p class="error-box">실 API 호출 실패로 목업으로 대체됨: ${data.engineError}</p>` : ''}
				`;
			} catch (err) {
				box.hidden = false;
				box.innerHTML = `<p class="error-box">오류: ${err.message}</p>`;
			} finally {
				btn.disabled = false;
				btn.textContent = '컨셉 이미지 생성';
			}
		});
	}

	// ---- checklist tab ----
	function assigneeOptionsHtml(members, selectedId) {
		return `<option value="">미지정</option>` + members.map((m) =>
			`<option value="${m.id}" ${m.id === selectedId ? 'selected' : ''}>${escapeHtml(m.name || m.username || '이름없음')}</option>`
		).join('');
	}

	async function initChecklistTab() {
		loadChecklist();
		const members = await loadTeamMembers();
		const assigneeSelect = document.getElementById('task-assignee');
		if (assigneeSelect) assigneeSelect.innerHTML = assigneeOptionsHtml(members, '');

		document.getElementById('task-add-btn')?.addEventListener('click', async () => {
			const input = document.getElementById('task-input');
			const title = input.value.trim();
			if (!title) return;
			const assigneeId = document.getElementById('task-assignee')?.value || null;
			const btn = document.getElementById('task-add-btn');
			btn.disabled = true;
			const { error } = await supabase.from('ip_project_tasks').insert({ project_id: projectId, title, assignee_id: assigneeId });
			btn.disabled = false;
			if (error) {
				alert(`추가 실패: ${error.message}`);
				return;
			}
			input.value = '';
			if (assigneeSelect) assigneeSelect.value = '';
			loadChecklist();
		});
	}

	async function loadChecklist() {
		const list = document.getElementById('task-list');
		const addRow = document.getElementById('task-add-row');
		const addActions = document.getElementById('task-add-actions');
		if (!list) return;

		const access = await loadTeamAccess();

		if (addRow) addRow.style.display = access.canWrite ? '' : 'none';
		if (addActions) addActions.style.display = access.canWrite ? '' : 'none';

		if (!access.canRead) {
			list.innerHTML = requestAccessHtml('로그인한 팀원 중 권한을 부여받은 분만 체크리스트를 볼 수 있습니다.');
			return;
		}

		const { data, error } = await supabase
			.from('ip_project_tasks')
			.select('*')
			.eq('project_id', projectId)
			.order('sort_order', { ascending: true })
			.order('created_at', { ascending: true });

		if (error) {
			list.innerHTML = `<p class="error-box">오류: ${error.message}</p>`;
			return;
		}
		if (!data || data.length === 0) {
			list.innerHTML = `<p class="hint">아직 등록된 할 일이 없습니다.</p>`;
			return;
		}

		const members = await loadTeamMembers();
		const memberName = (id) => members.find((m) => m.id === id)?.name || members.find((m) => m.id === id)?.username;

		list.innerHTML = data.map((t) => `
			<div class="list-item task-item" data-id="${t.id}">
				<label class="task-label">
					<input type="checkbox" class="task-check" data-id="${t.id}" ${t.is_done ? 'checked' : ''} ${access.canWrite ? '' : 'disabled'} />
					<span class="${t.is_done ? 'done' : ''}">${escapeHtml(t.title)}</span>
				</label>
				<span class="item-actions">
					${access.canWrite
						? `<select class="task-assignee-select" data-id="${t.id}">${assigneeOptionsHtml(members, t.assignee_id)}</select>`
						: `<span class="assignee-badge">${t.assignee_id ? escapeHtml(memberName(t.assignee_id) || '담당자') : '미지정'}</span>`}
					${access.canWrite ? `<button class="delete-btn task-delete-btn" data-id="${t.id}">삭제</button>` : ''}
				</span>
			</div>
		`).join('');

		if (access.canWrite) {
			list.querySelectorAll('.task-check').forEach((cb) => {
				cb.addEventListener('change', async () => {
					await supabase.from('ip_project_tasks').update({ is_done: cb.checked }).eq('id', cb.dataset.id);
					loadChecklist();
				});
			});
			list.querySelectorAll('.task-delete-btn').forEach((btn) => {
				btn.addEventListener('click', async () => {
					await supabase.from('ip_project_tasks').delete().eq('id', btn.dataset.id);
					loadChecklist();
				});
			});
			list.querySelectorAll('.task-assignee-select').forEach((sel) => {
				sel.addEventListener('change', async () => {
					await supabase.from('ip_project_tasks').update({ assignee_id: sel.value || null }).eq('id', sel.dataset.id);
					loadChecklist();
				});
			});
		}
	}

	// ---- comments tab ----
	function initCommentsTab() {
		loadComments();
		document.getElementById('comment-add-btn')?.addEventListener('click', async () => {
			const input = document.getElementById('comment-input');
			const content = input.value.trim();
			if (!content) return;
			const btn = document.getElementById('comment-add-btn');
			btn.disabled = true;
			btn.textContent = '등록 중...';
			const { error } = await supabase.rpc('create_project_comment', {
				p_project_id: projectId,
				p_content: content,
			});
			btn.disabled = false;
			btn.textContent = '댓글 등록';
			if (error) {
				alert(`등록 실패: ${error.message}`);
				return;
			}
			input.value = '';
			loadComments();
		});
	}

	async function loadComments() {
		const list = document.getElementById('comment-list');
		const addRow = document.getElementById('comment-add-row');
		const addActions = document.getElementById('comment-add-actions');
		if (!list) return;

		const access = await loadTeamAccess();
		if (addRow) addRow.style.display = access.canWrite ? '' : 'none';
		if (addActions) addActions.style.display = access.canWrite ? '' : 'none';

		if (!access.canRead) {
			list.innerHTML = requestAccessHtml('로그인한 팀원 중 권한을 부여받은 분만 댓글을 볼 수 있습니다.');
			return;
		}

		const { data: { session } } = await supabase.auth.getSession();
		const myId = session?.user?.id;

		const [{ data, error }, members] = await Promise.all([
			supabase.from('ip_project_comments').select('*').eq('project_id', projectId).order('created_at', { ascending: false }),
			loadTeamMembers(),
		]);

		if (error) {
			list.innerHTML = `<p class="error-box">오류: ${error.message}</p>`;
			return;
		}
		if (!data || data.length === 0) {
			list.innerHTML = `<p class="hint">아직 댓글이 없습니다.</p>`;
			return;
		}

		const authorName = (id) => {
			const m = members.find((m) => m.id === id);
			return m ? (m.name || m.username || '팀원') : '팀원';
		};

		list.innerHTML = data.map((c) => `
			<div class="list-item" data-id="${c.id}">
				<span class="item-title">
					${escapeHtml(authorName(c.user_id))}
					<small class="item-meta">${new Date(c.created_at).toLocaleString('ko-KR')}</small>
					<span class="item-text">${escapeHtml(c.content)}</span>
				</span>
				${c.user_id === myId ? `<span class="item-actions"><button class="delete-btn comment-delete-btn" data-id="${c.id}">삭제</button></span>` : ''}
			</div>
		`).join('');

		list.querySelectorAll('.comment-delete-btn').forEach((btn) => {
			btn.addEventListener('click', async () => {
				await supabase.from('ip_project_comments').delete().eq('id', btn.dataset.id);
				loadComments();
			});
		});
	}

	// ---- activity log tab ----
	const ACTIVITY_LABELS = {
		stage_changed: (detail) => `단계가 변경되었습니다 (${escapeHtml(detail)})`,
		task_created: (detail) => `할 일 추가: ${escapeHtml(detail)}`,
		task_completed: (detail) => `할 일 완료: ${escapeHtml(detail)}`,
		task_reopened: (detail) => `할 일 다시 열림: ${escapeHtml(detail)}`,
		task_deleted: (detail) => `할 일 삭제: ${escapeHtml(detail)}`,
		comment_added: (detail) => `댓글 작성: ${escapeHtml(detail)}`,
		reference_saved: (detail) => `레퍼런스 저장: ${escapeHtml(detail)}`,
	};

	async function loadActivity() {
		const list = document.getElementById('activity-list');
		if (!list) return;

		const access = await loadTeamAccess();
		if (!access.canRead) {
			list.innerHTML = requestAccessHtml('로그인한 팀원 중 권한을 부여받은 분만 활동 기록을 볼 수 있습니다.');
			return;
		}

		const [{ data, error }, members] = await Promise.all([
			supabase.from('ip_project_activity_log').select('*').eq('project_id', projectId).order('created_at', { ascending: false }).limit(50),
			loadTeamMembers(),
		]);

		if (error) {
			list.innerHTML = `<p class="error-box">오류: ${error.message}</p>`;
			return;
		}
		if (!data || data.length === 0) {
			list.innerHTML = `<p class="hint">아직 활동 기록이 없습니다.</p>`;
			return;
		}

		const actorName = (id) => {
			const m = members.find((m) => m.id === id);
			return m ? (m.name || m.username || '팀원') : '팀원';
		};

		list.innerHTML = data.map((a) => {
			const describe = ACTIVITY_LABELS[a.action] || (() => escapeHtml(a.action));
			return `
				<div class="list-item">
					<span class="item-title">
						${escapeHtml(actorName(a.actor_id))} · ${describe(a.detail)}
						<small class="item-meta">${new Date(a.created_at).toLocaleString('ko-KR')}</small>
					</span>
				</div>
			`;
		}).join('');
	}
</script>

