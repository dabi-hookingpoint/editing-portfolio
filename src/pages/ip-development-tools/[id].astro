---
import Layout from '../../layouts/Layout.astro';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
	const projects = await getCollection('ipProjects');
	return projects.map((p) => ({ params: { id: p.id } }));
}

const { id } = Astro.params;
const project = await getEntry('ipProjects', id);
const { title, genre, stage } = project.data;
---

<Layout title={`${title} — IP DEVELOPMENT — Hooking Point`}>
	<div class="page" data-project-id={id} data-project-title={title}>
		<a class="back-link" href="/ip-development-tools">← IP DEVELOPMENT 목록으로</a>

		<span class="stage-badge">{stage}</span>
		<h1>{title}</h1>
		<p class="ip-genre">{genre}</p>

		<section class="tools-section">
			<h2>AI 도구</h2>

			<nav class="tool-tabs">
				<button type="button" data-tab="record" class="tab-btn active">① 회의 녹음/저장</button>
				<button type="button" data-tab="analyze" class="tab-btn">② 구조 분석 · 레퍼런스</button>
				<button type="button" data-tab="image" class="tab-btn">③ 컨셉 이미지</button>
			</nav>

			<section class="tool-panel active" id="panel-record">
				<div class="tool-card">
					<div class="form-row">
						<div class="field"><label>감독/상대</label><input type="text" id="rec-director" placeholder="예: OO 감독" /></div>
						<div class="field"><label>회의 날짜</label><input type="date" id="rec-date" /></div>
					</div>
					<div class="form-actions">
						<button type="button" class="rec-toggle-btn" id="rec-toggle">● 녹음 시작</button>
						<button type="button" class="cancel-btn" id="rec-clear">지우기</button>
					</div>
					<textarea id="rec-text" rows="6" placeholder="녹음 시작 후 말하면 실시간으로 텍스트가 쌓입니다. 말이 1.5초 이상 끊기면 자동으로 화자(A, B)가 전환됩니다(무료 방식 — 정확하지 않을 수 있어요). 직접 타이핑해서 수정해도 됩니다."></textarea>
					<p class="hint" id="rec-hint">크롬(Chrome) 브라우저에서만 지원됩니다. 마이크 권한을 허용해주세요.</p>
					<div class="form-actions">
						<button type="button" class="save-btn" id="rec-save">이 내용 저장 (저장 시 AI 요약 자동 생성)</button>
					</div>
				</div>
				<div class="tool-card">
					<h2>저장된 회의 기록 — 이 프로젝트</h2>
					<div id="rec-list"></div>
				</div>
			</section>

			<section class="tool-panel" id="panel-analyze">
				<div class="tool-card">
					<label class="field-label" for="an-text">시나리오/시놉시스 텍스트 (씬·문단 사이는 빈 줄로 구분)</label>
					<textarea id="an-text" rows="10"></textarea>
					<div class="form-actions">
						<button type="button" class="save-btn" id="an-run">3막 구조 분석하기</button>
						<button type="button" class="save-btn accent" id="ref-run">레퍼런스 작품 추천받기</button>
					</div>
				</div>
				<div class="tool-card" id="an-result" hidden></div>
				<div class="tool-card" id="ref-result" hidden></div>
			</section>

			<section class="tool-panel" id="panel-image">
				<div class="tool-card">
					<label class="field-label" for="im-prompt">씬 설명 / 컨셉 프롬프트</label>
					<textarea id="im-prompt" rows="4" placeholder="예: 비 내리는 도심 골목, 네온사인 반사, 느와르 톤, 영화적 조명"></textarea>
					<p class="hint">문장으로 길게 쓰기보다, 장소·인물·행동·분위기 등 핵심 키워드를 쉼표로 나열하면 더 정확한 이미지가 나옵니다.</p>
					<div class="form-actions">
						<button type="button" class="save-btn" id="im-run">컨셉 이미지 생성</button>
					</div>
					<p class="hint" id="im-hint"></p>
				</div>
				<div class="tool-card" id="im-result" hidden></div>
			</section>
		</section>
	</div>
</Layout>

<script>
	import { supabase } from '../../lib/supabase';

	// 로컬스토리지 기반 회의 기록 저장은 유지 중입니다(추후 pd_meeting_transcripts 테이블로 전환 예정).

	const projectId = (document.querySelector('.page') as HTMLElement).dataset.projectId!;
	const LOCAL_TRANSCRIPTS_KEY = `pd_meeting_transcripts_${projectId}`;

	checkAccessAndInit();

	async function checkAccessAndInit() {
		// 로그인 없이 누구나 사용할 수 있도록 열어둔 상태입니다.
		initTools();
	}

	function initTools() {
		initTabs();
		initStatusBadges();
		initRecordTab();
		initAnalyzeTab();
		initImageTab();
		loadTranscripts();
	}

	// ---- tabs ----
	function initTabs() {
		const tabButtons = document.querySelectorAll('.tab-btn');
		const panels = {
			record: document.getElementById('panel-record'),
			analyze: document.getElementById('panel-analyze'),
			image: document.getElementById('panel-image'),
		};
		tabButtons.forEach((btn) => {
			btn.addEventListener('click', () => {
				tabButtons.forEach((b) => b.classList.remove('active'));
				btn.classList.add('active');
				Object.values(panels).forEach((p) => p?.classList.remove('active'));
				const key = btn.dataset.tab ?? '';
				panels[key]?.classList.add('active');
			});
		});
	}

	async function authHeaders() {
		const { data: { session } } = await supabase.auth.getSession();
		const headers = { 'content-type': 'application/json' };
		if (session?.access_token) headers.authorization = `Bearer ${session.access_token}`;
		return headers;
	}

	async function apiCall(path, body) {
		const res = await fetch(path, {
			method: 'POST',
			headers: await authHeaders(),
			body: JSON.stringify(body),
		});
		const data = await res.json();
		if (!res.ok) throw new Error(data?.error || `요청 실패 (${res.status})`);
		return data;
	}

	async function initStatusBadges() {
		try {
			const res = await fetch('/api/status', { headers: await authHeaders() });
			const data = await res.json();
			if (!res.ok) throw new Error(data?.error || `요청 실패 (${res.status})`);
			const imHint = document.getElementById('im-hint');
			if (imHint) {
				if (data.imageEngine === 'mock') {
					imHint.textContent = '현재 이미지 생성 엔진이 설정되지 않아 목업(그라디언트) 이미지로 대체됩니다.';
				} else if (data.imageEngine === 'workers-ai') {
					imHint.textContent = 'Cloudflare Workers AI(무료)로 실제 이미지를 생성합니다.';
				} else if (data.imageEngine === 'colab') {
					imHint.textContent = 'Colab GPU에서 실행 중인 Stable Diffusion으로 이미지를 생성합니다. 노트북이 꺼져 있으면 목업으로 대체됩니다.';
				} else {
					imHint.textContent = `${data.imageEngine} API로 실제 이미지를 생성합니다.`;
				}
			}
		} catch {
			// 상태 배지는 참고용이라 실패해도 조용히 무시
		}
	}

	// ---- record tab (+ 무료 화자 자동구분: 침묵 기반 추정) ----
	function initRecordTab() {
		const recText = document.getElementById('rec-text');
		const recToggle = document.getElementById('rec-toggle');
		const recHint = document.getElementById('rec-hint');

		const PAUSE_THRESHOLD_MS = 1500;
		let recognition = null;
		let recognizing = false;
		let baseText = '';
		let currentSpeaker = 'A';
		let lastFinalAt = 0;

		const SpeechRecognitionImpl = window.SpeechRecognition || window.webkitSpeechRecognition;

		function appendFinal(text) {
			const now = Date.now();
			if (lastFinalAt && now - lastFinalAt > PAUSE_THRESHOLD_MS) {
				currentSpeaker = currentSpeaker === 'A' ? 'B' : 'A';
			}
			lastFinalAt = now;
			baseText += (baseText ? '\n\n' : '') + `[화자 ${currentSpeaker}] ` + text;
		}

		if (!SpeechRecognitionImpl) {
			recToggle.disabled = true;
			if (recHint) recHint.textContent = '이 브라우저는 음성인식(Web Speech API)을 지원하지 않습니다. 크롬(Chrome)에서 열어주세요. 직접 타이핑은 가능합니다.';
		} else {
			recognition = new SpeechRecognitionImpl();
			recognition.lang = 'ko-KR';
			recognition.continuous = true;
			recognition.interimResults = true;

			recognition.onresult = (event) => {
				let finalChunk = '';
				let interimChunk = '';
				for (let i = event.resultIndex; i < event.results.length; i++) {
					const transcript = event.results[i][0].transcript;
					if (event.results[i].isFinal) finalChunk += transcript;
					else interimChunk += transcript;
				}
				if (finalChunk) appendFinal(finalChunk.trim());
				recText.value = baseText + (interimChunk ? ` [${interimChunk}]` : '');
			};
			recognition.onerror = (e) => {
				if (recHint) recHint.textContent = `음성인식 오류: ${e.error}. 마이크 권한을 확인해주세요.`;
			};
			recognition.onend = () => {
				if (recognizing) recognition.start();
			};
		}

		recToggle.addEventListener('click', () => {
			if (!recognition) return;
			if (!recognizing) {
				baseText = recText.value;
				lastFinalAt = 0;
				currentSpeaker = 'A';
				recognizing = true;
				recognition.start();
				recToggle.textContent = '■ 녹음 중지';
				recToggle.classList.add('on');
				if (recHint) recHint.textContent = '듣고 있습니다... 말이 1.5초 이상 끊기면 자동으로 화자가 전환됩니다 (무료 방식이라 정확하지 않을 수 있어요 — 필요하면 직접 수정하세요).';
			} else {
				recognizing = false;
				recognition.stop();
				recToggle.textContent = '● 녹음 시작';
				recToggle.classList.remove('on');
				if (recHint) recHint.textContent = '녹음이 중지되었습니다.';
			}
		});

		document.getElementById('rec-clear')?.addEventListener('click', () => {
			baseText = '';
			lastFinalAt = 0;
			recText.value = '';
		});

		document.getElementById('rec-save')?.addEventListener('click', async () => {
			const text = recText.value.trim();
			if (!text) return;
			const director = document.getElementById('rec-director').value || '미지정';
			const date = document.getElementById('rec-date').value || '';
			const record = saveTranscriptLocal({ director, date, content: text, char_count: text.length });
			recText.value = '';
			baseText = '';
			lastFinalAt = 0;
			document.getElementById('rec-date').value = '';
			await loadTranscripts();
			document.querySelector(`.summarize-btn[data-id="${record.id}"]`)?.click();
		});
	}

	function readTranscriptsLocal() {
		try {
			return JSON.parse(localStorage.getItem(LOCAL_TRANSCRIPTS_KEY) || '[]');
		} catch {
			return [];
		}
	}

	function saveTranscriptLocal(entry) {
		const records = readTranscriptsLocal();
		const record = {
			id: `local_${Date.now()}_${Math.floor(Math.random() * 1e6)}`,
			created_at: new Date().toISOString(),
			...entry,
		};
		records.push(record);
		localStorage.setItem(LOCAL_TRANSCRIPTS_KEY, JSON.stringify(records));
		return record;
	}

	function deleteTranscriptLocal(id) {
		const records = readTranscriptsLocal().filter((r) => r.id !== id);
		localStorage.setItem(LOCAL_TRANSCRIPTS_KEY, JSON.stringify(records));
	}

	async function loadTranscripts() {
		const list = document.getElementById('rec-list');
		if (!list) return;
		const data = readTranscriptsLocal().sort((a, b) => (a.created_at < b.created_at ? 1 : -1));

		if (data.length === 0) {
			list.innerHTML = `<p class="hint">아직 저장된 기록이 없습니다. (이 브라우저 · 이 프로젝트에만 저장됩니다 — 로그인 연동 전 임시 방식입니다.)</p>`;
			return;
		}

		list.innerHTML = data.map((r) => `
			<div class="list-item" data-id="${r.id}">
				<span class="item-title">
					${r.director}
					<small class="item-meta">${r.date ? `회의일 ${r.date} · ` : ''}저장 ${new Date(r.created_at).toLocaleString('ko-KR')} · ${r.char_count}자</small>
					<span class="item-text">${escapeHtml(r.content).slice(0, 200)}${r.content.length > 200 ? '…' : ''}</span>
					<span class="item-summary" id="summary-${r.id}" hidden></span>
				</span>
				<span class="item-actions">
					<button class="summarize-btn" data-id="${r.id}">요약하기</button>
					<button class="delete-btn" data-id="${r.id}">삭제</button>
				</span>
			</div>
		`).join('');

		list.querySelectorAll('.delete-btn').forEach((btn) => {
			btn.onclick = () => {
				if (btn.dataset.id) deleteTranscriptLocal(btn.dataset.id);
				loadTranscripts();
			};
		});

		list.querySelectorAll('.summarize-btn').forEach((btn) => {
			btn.onclick = async () => {
				const record = data.find((r) => r.id === btn.dataset.id);
				const summaryBox = document.getElementById(`summary-${btn.dataset.id}`);
				if (!record || !summaryBox) return;
				btn.disabled = true;
				btn.textContent = '요약 중...';
				try {
					const result = await apiCall('/api/summarize', { text: record.content });
					summaryBox.hidden = false;
					summaryBox.innerHTML = `
						<span class="badge">엔진: ${result.engine}</span>
						<p>${result.summary || ''}</p>
						${result.keyPoints?.length ? `<ul class="issues plain">${result.keyPoints.map((k) => `<li>${k}</li>`).join('')}</ul>` : ''}
						${result.speakerNotes ? `<ul class="issues plain">${Object.entries(result.speakerNotes).map(([k, v]) => `<li><strong>화자 ${k}:</strong> ${v}</li>`).join('')}</ul>` : ''}
						${result.engineError ? `<p class="error-box">LLM 호출 실패로 휴리스틱 요약으로 대체됨: ${result.engineError}</p>` : ''}
					`;
				} catch (err) {
					summaryBox.hidden = false;
					summaryBox.innerHTML = `<p class="error-box">오류: ${err.message}</p>`;
				} finally {
					btn.disabled = false;
					btn.textContent = '요약하기';
				}
			};
		});
	}

	function escapeHtml(s) {
		return s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));
	}

	// ---- analyze + reference tab ----
	function initAnalyzeTab() {
		const anText = document.getElementById('an-text');
		const anResult = document.getElementById('an-result');
		const refResult = document.getElementById('ref-result');

		function actBlock(label, act, hitsKey) {
			const ratio = act?.ratio != null ? Math.round(act.ratio * 100) : null;
			const hits = act?.[hitsKey] || [];
			return `
				<div class="act-block">
					<h3>${label} ${ratio != null ? `<span class="muted">(분량 ${ratio}%)</span>` : ''}</h3>
					${ratio != null ? `<div class="bar-track"><div class="bar-fill" style="width:${ratio}%"></div></div>` : ''}
					${act?.summary ? `<p>${act.summary}</p>` : ''}
					${hits.length ? `<p class="hint">감지된 전환 표현: ${hits.join(', ')}</p>` : ''}
					${act?.issues?.length ? `<ul class="issues">${act.issues.map((i) => `<li>${i}</li>`).join('')}</ul>` : ''}
				</div>`;
		}

		document.getElementById('an-run')?.addEventListener('click', async () => {
			const text = anText.value.trim();
			if (!text) return;
			const btn = document.getElementById('an-run');
			btn.disabled = true;
			btn.textContent = '분석 중...';
			try {
				const data = await apiCall('/api/analyze', { text });
				anResult.hidden = false;
				if (data.warning) {
					anResult.innerHTML = `<p class="error-box">${data.warning}</p>`;
					return;
				}
				anResult.innerHTML = `
					<span class="badge">엔진: ${data.engine}</span>
					${actBlock('1막 · 설정', data.act1, 'turningPointHits')}
					${actBlock('2막 · 대립·전개', data.act2, 'midpointHits')}
					${actBlock('3막 · 해결', data.act3, 'resolutionHits')}
					${data.overallIssues?.length ? `<h3>전체 구조 문제점</h3><ul class="issues">${data.overallIssues.map((i) => `<li>${i}</li>`).join('')}</ul>` : ''}
					${data.recommendations?.length ? `<h3>수정 제안</h3><ul class="recs">${data.recommendations.map((i) => `<li>${i}</li>`).join('')}</ul>` : ''}
					${data.engineError ? `<p class="error-box">LLM 호출 실패로 휴리스틱 분석으로 대체됨: ${data.engineError}</p>` : ''}
				`;
			} catch (err) {
				anResult.hidden = false;
				anResult.innerHTML = `<p class="error-box">오류: ${err.message}</p>`;
			} finally {
				btn.disabled = false;
				btn.textContent = '3막 구조 분석하기';
			}
		});

		document.getElementById('ref-run')?.addEventListener('click', async () => {
			const text = anText.value.trim();
			if (!text) return;
			const btn = document.getElementById('ref-run');
			btn.disabled = true;
			btn.textContent = '추천 중...';
			try {
				const data = await apiCall('/api/references', { text });
				refResult.hidden = false;
				const refs = data.references || [];
				refResult.innerHTML = `
					<span class="badge">엔진: ${data.engine}</span>
					<h3>추천 레퍼런스 작품 (${refs.length}편)</h3>
					${refs.length ? `<ul class="issues plain">${refs.map((r) => `<li><strong>${r.title}</strong>${r.year ? ` (${r.year})` : ''} · ${r.type || ''}<div class="hint">${r.reason || ''}</div></li>`).join('')}</ul>` : `<p class="hint">추천 결과가 없습니다.</p>`}
					${data.detectedTags?.length ? `<p class="hint">감지된 키워드: ${data.detectedTags.join(', ')}</p>` : ''}
					${data.engineError ? `<p class="error-box">LLM 호출 실패로 큐레이션 DB 매칭으로 대체됨: ${data.engineError}</p>` : ''}
				`;
			} catch (err) {
				refResult.hidden = false;
				refResult.innerHTML = `<p class="error-box">오류: ${err.message}</p>`;
			} finally {
				btn.disabled = false;
				btn.textContent = '레퍼런스 작품 추천받기';
			}
		});
	}

	// ---- image tab ----
	function initImageTab() {
		document.getElementById('im-run')?.addEventListener('click', async () => {
			const prompt = document.getElementById('im-prompt').value.trim();
			if (!prompt) return;
			const btn = document.getElementById('im-run');
			const box = document.getElementById('im-result');
			btn.disabled = true;
			btn.textContent = '생성 중...';
			try {
				const data = await apiCall('/api/concept-image', { prompt });
				box.hidden = false;
				box.innerHTML = `
					<span class="badge">엔진: ${data.provider}</span><br/>
					<img class="concept-img" src="${data.url}" alt="concept image" />
					${data.finalPrompt ? `<p class="hint">실제 사용된 프롬프트: ${data.finalPrompt}</p>` : ''}
					${data.engineError ? `<p class="error-box">실 API 호출 실패로 목업으로 대체됨: ${data.engineError}</p>` : ''}
				`;
			} catch (err) {
				box.hidden = false;
				box.innerHTML = `<p class="error-box">오류: ${err.message}</p>`;
			} finally {
				btn.disabled = false;
				btn.textContent = '컨셉 이미지 생성';
			}
		});
	}
</script>

<style>
	h1 {
		margin: 0.6rem 0 0.3rem;
	}
	.back-link {
		display: inline-block;
		margin-bottom: 1.5rem;
		color: var(--muted);
		transition: color 0.15s ease;
	}
	.back-link:hover {
		color: var(--fg);
	}
	.stage-badge {
		display: inline-block;
		font-size: 0.7rem;
		font-weight: 700;
		letter-spacing: 0.05em;
		color: var(--heading);
		border: 1px solid var(--accent);
		background: var(--accent-dim);
		border-radius: 999px;
		padding: 0.2rem 0.6rem;
	}
	.ip-genre {
		color: var(--muted);
		margin: 0.3rem 0 2rem;
	}

	.tools-section h2 {
