---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const works = (await getCollection('works')).sort((a, b) => a.data.sortOrder - b.data.sortOrder);
const types = ['전체', ...new Set(works.map((w) => w.data.type))];
---

<Layout title="EDITING / WORKS — Hooking Point">
	<div class="hero-band">
		<span class="blob blob-1" aria-hidden="true"></span>
		<span class="blob blob-2" aria-hidden="true"></span>
		<div class="hero-band-inner">
			<h1>EDITING · WORKS</h1>
		</div>
	</div>

	<div class="page">
		<a class="back-link" href="/">← 홈으로</a>

		<div class="filters" role="tablist">
			{types.map((t, i) => (
				<button type="button" class="filter" data-filter={t} aria-pressed={i === 0 ? 'true' : 'false'}>
					{t}
				</button>
			))}
		</div>

		<ul class="work-grid">
			{works.map((work) => (
				<li class="work-card" data-type={work.data.type}>
					<a href={`/works/${work.id}`}>
						<img src={work.data.image} alt={work.data.title} loading="lazy" />
						<div class="work-meta">
							<h2>{work.data.title}</h2>
							<p class="year">{work.data.releaseYear}</p>
						</div>
					</a>
				</li>
			))}
		</ul>
	</div>
</Layout>

<script>
	const filters = document.querySelectorAll<HTMLButtonElement>('.filter');
	const cards = document.querySelectorAll<HTMLLIElement>('.work-card');

	filters.forEach((btn) => {
		btn.addEventListener('click', () => {
			filters.forEach((b) => b.setAttribute('aria-pressed', 'false'));
			btn.setAttribute('aria-pressed', 'true');
			const target = btn.dataset.filter;
			cards.forEach((card) => {
				const show = target === '전체' || card.dataset.type === target;
				card.style.display = show ? '' : 'none';
			});
		});
	});
</script>

<style>
	.hero-band {
		position: relative;
		overflow: hidden;
		background: linear-gradient(135deg, #0f2fa8, var(--accent) 60%, #2e64f2);
		padding: 1.75rem 2rem;
		margin-bottom: 2.5rem;
	}
	.hero-band-inner {
		position: relative;
		z-index: 1;
		max-width: 1100px;
		margin-inline: auto;
	}
	.hero-band h1 {
		margin: 0;
		font-size: 1.7rem;
		color: #fff;
	}
	.blob {
		position: absolute;
		border-radius: 50%;
		background: rgba(255, 255, 255, 0.08);
		filter: blur(2px);
	}
	.blob-1 {
		width: 220px;
		height: 220px;
		top: -160px;
		right: 8%;
	}
	.blob-2 {
		width: 160px;
		height: 160px;
		bottom: -130px;
		right: 24%;
		background: rgba(255, 255, 255, 0.06);
	}

	.back-link {
		display: inline-block;
		margin-bottom: 1.5rem;
		color: var(--muted);
		transition: color 0.15s ease;
	}
	.back-link:hover {
		color: var(--fg);
	}

	.filters {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		margin-bottom: 2.5rem;
	}
	.filter {
		font: inherit;
		font-size: 0.9rem;
		font-weight: 600;
		background: none;
		border: none;
		color: var(--muted);
		border-radius: 999px;
		padding: 0.5rem 1.1rem;
		cursor: pointer;
		transition: color 0.15s ease, background-color 0.15s ease;
	}
	.filter:hover {
		color: var(--heading);
	}
	.filter[aria-pressed='true'] {
		background: var(--surface-strong);
		color: var(--heading);
	}

	.work-grid {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
		gap: 2rem 1.5rem;
	}
	.work-card {
		transition: transform 0.15s ease;
	}
	.work-card:hover {
		transform: translateY(-2px);
	}
	.work-card a {
		display: block;
	}
	.work-card img {
		width: 100%;
		aspect-ratio: 2 / 3;
		object-fit: cover;
		border-radius: 8px;
		background: var(--border);
		display: block;
	}
	.work-meta {
		padding: 0.8rem 0.1rem 0;
	}
	.work-meta h2 {
		margin: 0 0 0.2rem;
		font-size: 1rem;
	}
	.work-meta .year {
		margin: 0;
		font-size: 0.85rem;
		color: var(--muted);
	}
</style>
